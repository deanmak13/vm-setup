#!/usr/bin/env bash
# pneuma-remote-gate — dev-box client: run a repo's pre-push gate for one exact
# commit on the build host (ci-builder) and bring the verdict + log back.
#
#   pneuma-remote-gate --head SHA --base SHA [--repo-dir DIR] [--profile NAME]
#   (--base is advisory: the scoping base is always merge-base(head, fresh origin/main))
#                      [--host ci-builder] [--log-dir DIR]
#
# Defaults: --repo-dir = cwd's repo, --profile = repo directory name with any
# leading "pneuma-" kept (profile files are gate-profiles/<name>.sh).
#
# Exit status (the ONLY trusted signal; a PASS means exactly head+tree):
#   0   gate GREEN on the builder for this head and tree
#   1   gate RED
#   3   nothing to gate (head already on origin/main, or no changed files) — not a verdict
#   75  no verdict (builder unreachable / refused / free disk < 25GiB / queue timeout /
#       result for a different commit) — treated as NOT green by callers
#
# What ships is the commit, never the worktree: a git bundle of head (and base)
# minus whatever the builder already holds. No credentials cross the wire; the
# builder runs the gate in a scrubbed environment with no ambient secrets.
set -uo pipefail

HOST="${PNEUMA_GATE_HOST:-ci-builder}"
EXPECT_HOST="${PNEUMA_GATE_EXPECT_HOST-vmi3387590}"
RUNNER="${PNEUMA_GATE_RUNNER:-/usr/local/bin/pneuma-gate-runner}"
SSH_OPTS=(-o BatchMode=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=6 -o ConnectTimeout=20)
PROBE_DEPTH="${PNEUMA_GATE_PROBE_DEPTH:-300}"

head="" base="" repo_dir="" profile="" log_dir="" scope_only=0
while [ $# -gt 0 ]; do
  case "$1" in
    --head) head="$2"; shift 2;; --base) base="$2"; shift 2;;
    --scope-only) scope_only=1; shift;;
    --repo-dir) repo_dir="$2"; shift 2;; --profile) profile="$2"; shift 2;;
    --host) HOST="$2"; shift 2;; --log-dir) log_dir="$2"; shift 2;;
    *) echo "pneuma-remote-gate: unknown argument $1" >&2; exit 2;;
  esac
done

# The caller's git hook exports GIT_DIR & friends; resolve everything explicitly.
G() { env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY \
        -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_COMMON_DIR -u GIT_PREFIX git -C "$repo_dir" "$@"; }
nogate() { echo "pneuma-remote-gate: $*" >&2; exit 75; }

[ -n "$repo_dir" ] || repo_dir="$(git rev-parse --show-toplevel 2>/dev/null)" || nogate "not inside a git repo (use --repo-dir)"
head="$(G rev-parse --verify --quiet "${head}^{commit}")" || nogate "--head is not a commit in $repo_dir"
# The scoping base is merge-base(head, FRESHLY fetched origin/main). A caller's
# --base is usually `git rev-parse origin/main` from a checkout that was last
# fetched days ago, and then every commit merged since inflates the selection
# (measured: P2-07 7bef90046 selected 17 services on a stale base, 2 on a fresh
# one, and FULL fan-out on another). Fetch, recompute, and say so when we differ.
# The origin must be this repo on GitHub, or the fetched main is someone else's.
repo_name="$(basename "$(G rev-parse --show-toplevel)")"
origin_url="$(G config --get remote.origin.url 2>/dev/null)" || nogate "no origin remote in $repo_dir"
case "$origin_url" in
  *github.com[:/]deanmak13/"$repo_name"|*github.com[:/]deanmak13/"$repo_name".git) ;;
  *) nogate "origin '$origin_url' is not deanmak13/$repo_name — refusing to scope on it" ;;
esac
fetch_err="$(mktemp)"
G fetch -q origin main 2>"$fetch_err" || nogate "cannot fetch origin/main: $(head -1 "$fetch_err") — refusing to scope on a stale base"
rm -f "$fetch_err"
# FETCH_HEAD is the tip this fetch just brought, not whatever refs/remotes/origin/main said before.
fresh_om="$(G rev-parse --verify --quiet 'FETCH_HEAD^{commit}')" || nogate "origin/main does not resolve after fetch"
fresh_base="$(G merge-base "$fresh_om" "$head")" || nogate "no merge-base between origin/main and $head"
if [ -n "$base" ] && [ "$(G rev-parse --verify --quiet "${base}^{commit}" 2>/dev/null)" != "$fresh_base" ]; then
  echo "remote-gate: WARNING caller --base ${base:0:12} is not merge-base(head, fresh origin/main) ${fresh_base:0:12}; scoping on ${fresh_base:0:12}" >&2
fi
base="$fresh_base"
# Nothing to gate: the head is already on main (it was gated when it landed), or it
# changes no files. The hook would exit 0 on an empty diff, which is a vacuous green,
# so say so and exit 3 (not a verdict; callers treat it as not green).
changed_count="$(G diff --name-only "$fresh_base" "$head" | grep -c .)"
if [ "$fresh_base" = "$head" ] || [ "$changed_count" = 0 ]; then
  echo "remote-gate: NOTHING TO GATE for ${head:0:12}: already on origin/main or no changed files — no verdict" >&2
  exit 3
fi
if [ "$scope_only" = 1 ]; then
  # Dry run: the scoping decision for this head, no bundle, no builder, no verdict.
  echo "remote-gate: scope-only head ${head:0:12} base ${fresh_base:0:12} ($changed_count changed file(s))"
  exit 0
fi
tree="$(G rev-parse "${head}^{tree}")"
repo="$(basename "$(G rev-parse --show-toplevel)")"
# The branch keys GATE-DEDUP-1 (a newer head of the same branch supersedes this gate).
# A detached HEAD has no branch: no dedup for it.
branch="$(G symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
# it is spliced into the builder's shell command: only a plain branch name may cross the wire
if [ -n "$branch" ] && { ! [[ "$branch" =~ ^[A-Za-z0-9._/-]{1,200}$ ]] || [[ "$branch" == *..* ]]; }; then
  nogate "branch name '$branch' has characters the builder does not accept"
fi
[ -n "$profile" ] || profile="$repo"
common="$(G rev-parse --path-format=absolute --git-common-dir)"
[ -n "$log_dir" ] || log_dir="$common/pneuma-remote-gate"
mkdir -p "$log_dir" || nogate "cannot create $log_dir"
log="$log_dir/${head:0:12}-$(date -u +%Y%m%dT%H%M%SZ).log"

echo "remote-gate: $repo ${head:0:12} (tree ${tree:0:12}) base ${base:0:12} -> $HOST profile=$profile" >&2
echo "remote-gate: log $log" >&2

# 1) Which of our recent ancestors does the builder already hold? Bundle only the delta.
cands=$( { echo "$base"; G rev-list --first-parent --max-count="$PROBE_DEPTH" "$head"; } | awk '!s[$0]++')
have=$(printf '%s\n' "$cands" | xargs ssh "${SSH_OPTS[@]}" "$HOST" "$RUNNER have --repo $repo" 2>"$log.err") \
  || { cat "$log.err" >&2; nogate "cannot reach $HOST (ssh failed) — no verdict"; }
prereq=$(printf '%s\n' "$cands" | grep -Fx -f <(printf '%s\n' "$have") | grep -vFx "$head" | head -1 || true)

# 2) Bundle: head (+ base) minus what the builder has. Temp refs name the tips.
tmpref_head="refs/pneuma-gate/head-${head:0:12}"; tmpref_base="refs/pneuma-gate/base-${base:0:12}"
bundle="$(mktemp "${TMPDIR:-/tmp}/pneuma-gate-bundle.XXXXXX")"
# The bundle BINDS the claim: the runner reads the repo and branch from these ref names and
# refuses a bundle whose refs do not match what it was told (GATE-DEDUP-1 binding).
tmpref_repo="refs/pneuma-gate/repo/$repo"; tmpref_branch="refs/pneuma-gate/branch/${branch:-detached}"
cleanup() { G update-ref -d "$tmpref_head" 2>/dev/null; G update-ref -d "$tmpref_base" 2>/dev/null; G update-ref -d "$tmpref_repo" 2>/dev/null; G update-ref -d "$tmpref_branch" 2>/dev/null; [ -n "${origin_main:-}" ] && G update-ref -d "$tmpref_om" 2>/dev/null; rm -f "$bundle" "$log.err"; }
trap cleanup EXIT
G update-ref "$tmpref_head" "$head" && G update-ref "$tmpref_base" "$base" || nogate "cannot name bundle tips"
# origin/main as this checkout last fetched it: guards resolve it, so it travels too.
origin_main="$(G rev-parse --verify --quiet 'refs/remotes/origin/main^{commit}' || true)"
tmpref_om="refs/pneuma-gate/om-${origin_main:0:12}"
refs=("$tmpref_head")
G update-ref "$tmpref_repo" "$head" && refs+=("$tmpref_repo") || nogate "cannot name the repo in the bundle"
if [ -n "$branch" ]; then G update-ref "$tmpref_branch" "$head" && refs+=("$tmpref_branch") || nogate "cannot name the branch in the bundle"; fi
if [ -n "$origin_main" ]; then G update-ref "$tmpref_om" "$origin_main"; refs+=("$tmpref_om"); fi
[ "$base" != "$head" ] && refs+=("$tmpref_base")
if [ -n "$prereq" ] && [ "$prereq" != "$head" ]; then
  G bundle create "$bundle" "${refs[@]}" "^$prereq" >/dev/null 2>&1 \
    || G bundle create "$bundle" "${refs[@]}" >/dev/null 2>&1 || nogate "git bundle failed"
else
  G bundle create "$bundle" "${refs[@]}" >/dev/null 2>&1 || nogate "git bundle failed"
fi
# Same scope knobs the local hook honours travel with the commit.
fwd_args=()
[ "${PNEUMA_PREPUSH_FULL:-}" = 1 ] && fwd_args+=(--env PNEUMA_PREPUSH_FULL=1)
shallow_args=()
[ -n "$origin_main" ] && fwd_args+=(--origin-main "$origin_main")
shallow_file="$(G rev-parse --path-format=absolute --git-path shallow)"
if [ -s "$shallow_file" ]; then
  # only the boundary commits that actually lie under what we ship
  sl=$(while read -r s; do
         if G merge-base --is-ancestor "$s" "$head" 2>/dev/null || G merge-base --is-ancestor "$s" "$base" 2>/dev/null \
            || { [ -n "$origin_main" ] && G merge-base --is-ancestor "$s" "$origin_main" 2>/dev/null; }; then echo "$s"; fi
       done < "$shallow_file" | paste -sd, -)
  [ -n "$sl" ] && shallow_args=(--shallow "$sl")
fi
echo "remote-gate: shipping $(du -h "$bundle" | cut -f1) bundle (builder already has ${prereq:+${prereq:0:12}}${prereq:+ and older}${prereq:-nothing yet})" >&2

# 3) Run. Output streams back live; the verdict is the PNEUMA_GATE_RESULT marker.
ssh "${SSH_OPTS[@]}" "$HOST" "$RUNNER run --profile $profile --repo $repo --head $head --base $base --tree $tree --bundle ${branch:+--branch $branch} ${shallow_args[*]:-} ${fwd_args[*]:-}" \
  < "$bundle" 2>&1 | tee "$log" >&2
ssh_rc=${PIPESTATUS[0]}

marker=$(grep '^PNEUMA_GATE_RESULT ' "$log" | tail -1)
[ -n "$marker" ] || nogate "no PNEUMA_GATE_RESULT marker (ssh exit $ssh_rc) — treating as NOT green; log $log"
field() { printf '%s' "$marker" | tr ' ' '\n' | sed -n "s/^$1=//p" | head -1; }
[ "$(field head)" = "$head" ] && [ "$(field tree)" = "$tree" ] \
  || nogate "result is for head=$(field head) tree=$(field tree), expected $head/$tree — NOT green"
[ -z "$EXPECT_HOST" ] || [ "$(field host)" = "$EXPECT_HOST" ] \
  || nogate "result came from host '$(field host)', not the approved builder $EXPECT_HOST — NOT green"
rc="$(field exit)"
case "$rc" in
  0) echo "remote-gate: GREEN for ${head:0:12} on $(field host) in $(field elapsed)  (log $log)" >&2; exit 0;;
  1) echo "remote-gate: RED for ${head:0:12} on $(field host) in $(field elapsed)  (log $log)" >&2; exit 1;;
  *) nogate "no verdict (exit=$rc $(printf '%s' "$marker" | sed -n 's/.*\(reason=.*\)/\1/p')) — NOT green; log $log";;
esac
