#!/usr/bin/env bash
# pneuma-gate-runner — runs a repo's pre-push gate for ONE exact commit on the
# dedicated build host (ci-builder), isolated per run, bounded by free capacity.
# Installed to /usr/local/bin by ci-builder-gate.sh; driven over ssh by the dev
# box's pneuma-remote-gate. Repo-specific knowledge lives in gate-profiles/*.sh
# (one file per repo; adding a repo is adding a profile, never editing this).
#
#   pneuma-gate-runner have   --repo R <sha>...     print the commits the host holds
#   pneuma-gate-runner run    --profile P --repo R --head SHA --base SHA --tree T
#                             [--bundle]            (bundle on stdin; log on stdout)
#   pneuma-gate-runner status                       capacity / disk / live runs
#   pneuma-gate-runner cancel --repo R --head SHA   cancel THIS submitter's jobs for that repo and head
#   pneuma-gate-runner janitor                      reap dead runs + stale keep-refs
#
# Verdict contract: the LAST stdout line of `run` is
#   PNEUMA_GATE_RESULT repo=.. head=.. tree=.. exit=N ...
# exit 0 = gate green for exactly that head+tree; 1 = gate RED; 75 = the gate
# did not run to a verdict (refused / queue timeout / infra) — never green.
#
# Isolation: each run gets its own clone (alternates to the shared object
# store), HOME, TMPDIR and gate lock; the dependency environment is an
# immutable cache keyed by the profile's key. Everything per-run is deleted on
# exit. The runner NEVER touches k3s or the GitHub runner services.
set -uo pipefail

BASE_DIR="${PNEUMA_GATE_BASE:-/var/lib/pneuma-gate}"
RUN_AS="${PNEUMA_GATE_RUN_AS-pneuma-gate}"           # empty = no privilege drop (tests)
PROFILE_DIR="${PNEUMA_GATE_PROFILE_DIR:-/usr/local/lib/pneuma-gate/profiles}"
EXPECT_HOST="${PNEUMA_GATE_EXPECT_HOST-vmi3387590}"   # approved builder identity
MIN_FREE_GIB="${PNEUMA_GATE_MIN_FREE_GIB:-40}"          # absolute free-space floor on $BASE_DIR's filesystem; ci-builder also runs k3s, whose kubelet evicts below ~10% free (~29GiB of 290GiB) — 40 leaves room for one ~5GiB gate above that line
RESERVE_CORES="${PNEUMA_GATE_RESERVE_CORES:-3}"       # left for runners + k3s
RESERVE_MEM_MB="${PNEUMA_GATE_RESERVE_MEM_MB:-6144}"
MAX_CONCURRENT="${PNEUMA_GATE_MAX_CONCURRENT:-4}"
GATE_TIMEOUT_S="${PNEUMA_GATE_TIMEOUT_S:-5400}"
LOAD_CEILING_PCT="${PNEUMA_GATE_LOAD_CEILING_PCT:-150}" # % of nproc; only blocks stacking a 2nd gate
POLL_S="${PNEUMA_GATE_POLL_S:-5}"
NPROC="${PNEUMA_GATE_NPROC:-$(nproc)}"
MEMINFO="${PNEUMA_GATE_MEMINFO:-/proc/meminfo}"
LOADAVG="${PNEUMA_GATE_LOADAVG:-/proc/loadavg}"

log() { printf '[gate-runner %s] %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }
as_gate() { if [ -n "$RUN_AS" ]; then runuser -u "$RUN_AS" -- "$@"; else "$@"; fi; }

# ── host identity + disk guard ───────────────────────────────────────────────
check_host() {
  [ -z "$EXPECT_HOST" ] && return 0
  [ "$(hostname)" = "$EXPECT_HOST" ]
}
disk_pct() { df --output=pcent "$BASE_DIR" 2>/dev/null | tail -1 | tr -dc '0-9'; }
# Admission is an ABSOLUTE floor, not a percentage: on a big disk 85% used can
# still leave far more than a gate needs (39G free at 87% used).
disk_free_gib() { df -BG --output=avail "$BASE_DIR" 2>/dev/null | tail -1 | tr -dc '0-9'; }

# ── capacity ─────────────────────────────────────────────────────────────────
mem_available_mb() { awk '/^MemAvailable:/ {print int($2/1024)}' "$MEMINFO"; }
load1_x100() { awk '{printf "%d", $1*100}' "$LOADAVG"; }
live_runs() {   # prints "<id> <cores> <mem_mb>" for each live run
  local d pid
  for d in "$BASE_DIR"/runs/*/; do
    [ -f "$d/pid" ] || continue
    pid="$(cat "$d/pid" 2>/dev/null)"
    { [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; } || continue
    printf '%s %s %s\n' "$(basename "$d")" "$(cat "$d/cores" 2>/dev/null || echo 1)" "$(cat "$d/mem_mb" 2>/dev/null || echo 2048)"
  done
}
# can_admit <cores> <mem_mb> — true when this gate fits beside the live ones
# AND beside whatever the host's runners/k3s are already using.
can_admit() {
  local cores="$1" mem="$2" n=0 used_c=0 id c m
  while read -r id c m; do
    [ -n "$id" ] || continue
    n=$((n + 1)); used_c=$((used_c + c))
  done < <(live_runs)
  [ "$n" -ge "$MAX_CONCURRENT" ] && return 1
  # Core budget = cores minus the reserve; one gate is always allowed to use
  # its own weight so a tiny host still makes progress.
  local budget=$((NPROC - RESERVE_CORES))
  [ "$budget" -lt "$cores" ] && budget="$cores"
  [ $((used_c + cores)) -gt "$budget" ] && return 1
  # Memory: what is available NOW (already net of live gates) minus the reserve.
  [ $(($(mem_available_mb) - RESERVE_MEM_MB)) -lt "$mem" ] && return 1
  # Load: when the host is already saturated by runners/k3s, only the first
  # gate may start (never stack gates on a starved box).
  if [ "$n" -gt 0 ] && [ "$(load1_x100)" -gt $((NPROC * LOAD_CEILING_PCT)) ]; then return 1; fi
  return 0
}

# ── repo store ───────────────────────────────────────────────────────────────
safe_name() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] && [ "$1" != . ] && [ "$1" != .. ]; }
store_for() { printf '%s/repos/%s.git' "$BASE_DIR" "$1"; }

cmd_have() {
  local repo="" shas=()
  while [ $# -gt 0 ]; do
    case "$1" in --repo) repo="$2"; shift 2;; *) shas+=("$1"); shift;; esac
  done
  safe_name "$repo" || { echo "bad repo" >&2; return 2; }
  local store; store="$(store_for "$repo")"
  [ -d "$store" ] || return 0
  printf '%s\n' "${shas[@]}" | git --git-dir="$store" cat-file --batch-check='%(objectname) %(objecttype)' 2>/dev/null | awk '$2=="commit"{print $1}'
}

# ── janitor ──────────────────────────────────────────────────────────────────
live_job_for_dir() {  # <id>: prints the id when its dedup record names a live pid or unit
  local id="$1" pid unit
  [ -f "$DEDUP_DIR/$id" ] || return 0
  pid="$(dedup_field "$id" pid)"; unit="$(dedup_field "$id" unit)"
  if kill -0 "$pid" 2>/dev/null || "$SYSTEMCTL_BIN" is-active --quiet "$unit" 2>/dev/null; then echo "$id"; fi
}
cmd_janitor() {
  local d pid store ref ts f
  for d in "$BASE_DIR"/runs/*/; do
    [ -d "$d" ] || continue
    pid="$(cat "$d/pid" 2>/dev/null || true)"
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
      log "janitor: removing dead run $(basename "$d")"; rm -rf "$d"
    fi
  done
  for f in "$BASE_DIR"/queue/*; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in in-*) [ -n "$(find "$f" -mmin +120 2>/dev/null)" ] && rm -f "$f"; continue;; esac
    pid="${f##*-}"; kill -0 "$pid" 2>/dev/null || rm -f "$f"
  done
  # verdict files older than a week: their jobs are long finished (a live job's file is written at its end)
  [ -d "$RESULTS_DIR" ] && find "$RESULTS_DIR" -mindepth 1 -maxdepth 1 -type f -mtime +7 -delete 2>/dev/null
  # job logs older than a week, unless their job is still live
  if [ -d "$JOBS_DIR" ]; then
    find "$JOBS_DIR" -mindepth 1 -maxdepth 1 -mtime +7 2>/dev/null | while read -r j; do
      [ -n "$(live_job_for_dir "$(basename "$j")")" ] || rm -rf -- "$j"
    done
  fi
  # keep-refs older than 2 days no longer pin their objects
  for store in "$BASE_DIR"/repos/*.git; do
    [ -d "$store" ] || continue
    git --git-dir="$store" for-each-ref --format='%(refname) %(committerdate:unix)' refs/gate-keep 2>/dev/null |
      while read -r ref ts; do
        [ $(($(date +%s) - ts)) -gt 172800 ] && git --git-dir="$store" update-ref -d "$ref"
      done
  done
  return 0
}

cmd_status() {
  echo "host=$(hostname) nproc=$NPROC mem_available_mb=$(mem_available_mb) load1=$(awk '{print $1}' "$LOADAVG") disk_pct=$(disk_pct) disk_free_gib=$(disk_free_gib)"
  echo "limits: disk_free>=${MIN_FREE_GIB}GiB reserve_cores=$RESERVE_CORES reserve_mem_mb=$RESERVE_MEM_MB max_concurrent=$MAX_CONCURRENT"
  live_runs | sed 's/^/live-run: /'
}

# ── run ──────────────────────────────────────────────────────────────────────
RUN_DIR=""; QUEUE_FILE=""; START_TS=0
DEDUP_ID=""; JOB_ID=""; JOB_KEY=""; WORKER_PID=""   # set by cmd_run / run_job; empty until then (the EXIT trap reads them)
R_REPO=""; R_HEAD=""; R_TREE=""; R_PROFILE=""; R_BASE=""; R_ORIGIN=""; R_ENV=""; R_SUBMITTER=""; R_JOBKEY=""
# The verdict's root-owned result file: written by the job (never parsed back from the shared log).
RESULTS_DIR="${PNEUMA_GATE_RESULTS_DIR:-/var/lib/pneuma-gate-results}"
# job_key: the ONE identity of a verdict's scope. Everything that can change what the gate decides is in it:
# repo, head, tree, submitter, profile, base, origin-main and the scope env flags (sorted, comma-joined).
job_key() {  # <repo> <head> <tree> <submitter> <profile> <base> <origin_main> <env>
  printf 'pneuma-gate-job-v1|repo=%s|head=%s|tree=%s|submitter=%s|profile=%s|base=%s|origin_main=%s|env=%s' \
    "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" | sha256sum | cut -d' ' -f1
}
result() {   # result <exit> [reason]: the verdict is written to the result file, and the stream shows that file's line
  local line tmp
  line="$(printf 'PNEUMA_GATE_RESULT repo=%s head=%s tree=%s profile=%s base=%s origin_main=%s env=%s submitter=%s jobkey=%s exit=%s elapsed=%ss host=%s%s' \
    "$R_REPO" "$R_HEAD" "$R_TREE" "$R_PROFILE" "$R_BASE" "$R_ORIGIN" "$R_ENV" "$R_SUBMITTER" "$R_JOBKEY" \
    "$1" "$(($(date +%s) - START_TS))" "$(hostname)" "${2:+ reason=\"$2\"}")"
  if [ -n "$JOB_ID" ] && [ -d "$RESULTS_DIR" ]; then
    tmp="$(mktemp "$RESULTS_DIR/.result.XXXXXX")" && printf '%s\n' "$line" > "$tmp" && mv -f -- "$tmp" "$RESULTS_DIR/$JOB_ID" \
      || log "WARNING: the verdict file for job $JOB_ID could not be written"
  fi
  printf '%s\n' "$line"
}
cleanup() {
  [ -n "$QUEUE_FILE" ] && rm -f "$QUEUE_FILE"
  [ -n "$RUN_DIR" ] && [ -d "$RUN_DIR" ] && rm -rf "$RUN_DIR"
  [ -n "$DEDUP_ID" ] && dedup_remove "$DEDUP_ID"
}
refuse() { log "REFUSED: $1"; result 75 "$1"; exit 75; }
refuse_noid() { echo "pneuma-gate-runner: refused: no submitter identity (only pneuma-gate-entry forces one)" >&2; exit 75; }

# GATE-DEDUP-1. A gate for a repo and branch makes every older gate of that branch unusable.
# Each run is recorded under a root-only directory with its key (repo/branch, never a SHA
# prefix), its head, its SUBMITTER, its runner pid and its unit. A newer head supersedes the
# older live runs of the SAME submitter and the SAME key:
#   - a queued run refuses at its next admission poll;
#   - a running run is cancelled by its UNIT NAME (systemctl stop). No stored pid is ever
#     signalled: a pid can be reused by an unrelated process.
# The submitter is the SSH key the client authenticated with, read by this ROOT runner from
# sshd's own auth record (ExposeAuthInfo). It is never a field the client supplies. When it is
# unknown, the run neither supersedes nor is superseded: the fail-safe is to cancel nothing.
DEDUP_DIR="${PNEUMA_GATE_DEDUP_DIR:-/var/lib/pneuma-gate-dedup}"
PER_SUBMITTER_CAP="${PNEUMA_GATE_PER_SUBMITTER_CAP:-3}"   # live gates one submitter may hold at once (queued + running)
SYSTEMCTL_BIN="${PNEUMA_GATE_SYSTEMCTL:-systemctl}"
dedup_register() {  # <id> <key> <head> <submitter> <unit> [jobkey]
  mkdir -p "$DEDUP_DIR" && chmod 0700 "$DEDUP_DIR" || return 1
  printf 'key=%s\nhead=%s\npid=%s\nsubmitter=%s\nunit=%s\njobkey=%s\nsuperseded=\n' "$2" "$3" "${WORKER_PID:-$$}" "$4" "$5" "${6:-}" > "$DEDUP_DIR/$1"
}
dedup_field() {  # <id> <field>
  local f="$DEDUP_DIR/$1"
  [ -f "$f" ] && [ ! -L "$f" ] || return 0
  sed -n "s/^$2=//p" "$f" | head -1
}
dedup_set() { [ -f "$DEDUP_DIR/$1" ] && [ ! -L "$DEDUP_DIR/$1" ] && sed -i "s/^$2=.*/$2=$3/" "$DEDUP_DIR/$1"; }
dedup_supersede() {  # <id> <store> <key> <head> <submitter>
  [ -n "$3" ] || return 0                     # no key (a detached run): nothing is superseded
  # Supersede the live runs of THIS key that the SAME submitter sent, when this head is a
  # DESCENDANT of theirs (or the two diverge: a force-push, the newest wins, and it is logged).
  # An older commit never cancels a newer one. Unknown ancestry, or an unknown submitter, cancels nothing.
  local store="$2" f other old unit
  [ -n "$5" ] || return 0
  for f in "$DEDUP_DIR"/*; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    other="$(basename "$f")"
    [ "$other" = "$1" ] && continue
    [ "$(dedup_field "$other" key)" = "$3" ] || continue           # the repo AND the branch
    [ "$(dedup_field "$other" submitter)" = "$5" ] || continue     # never another submitter's gate
    old="$(dedup_field "$other" head)"
    [ "$old" = "$4" ] && continue
    if ! kill -0 "$(dedup_field "$other" pid)" 2>/dev/null && ! "$SYSTEMCTL_BIN" is-active --quiet "$(dedup_field "$other" unit)" 2>/dev/null; then
      rm -f "$f"; continue                     # neither its runner nor its unit exists any more
    fi
    if git --git-dir="$store" merge-base --is-ancestor "$4" "$old" 2>/dev/null; then
      log "not superseding run $other: head ${4:0:12} is older than its head ${old:0:12}"
      continue                                  # an older commit never cancels a newer gate
    fi
    if git --git-dir="$store" merge-base --is-ancestor "$old" "$4" 2>/dev/null; then
      log "superseded run $other (head ${old:0:12}) by descendant ${4:0:12}"
    elif git --git-dir="$store" cat-file -e "$old^{commit}" 2>/dev/null; then
      log "superseded run $other (head ${old:0:12}) by ${4:0:12}: the heads DIVERGE (force-push); the newest submission wins"
    else
      log "not superseding run $other: its head ${old:0:12} is unknown to the store"
      continue                                  # unknown ancestry: fail safe, cancel nothing
    fi
    dedup_set "$other" superseded "$4"
    unit="$(dedup_field "$other" unit)"
    if [ -n "$unit" ]; then "$SYSTEMCTL_BIN" stop "$unit" >/dev/null 2>&1 || true; fi
  done
}

# The admission decision for a submission: record it and supersede under ONE root lock, so
# two simultaneous submissions cannot each miss the other (the later one wins). The lock lives
# in a subshell whose fd dies with it, so no gate code ever runs while it is open.
dedup_count_submitter() {  # <submitter>: live gates (queued or running) that submitter holds
  local f other n=0
  for f in "$DEDUP_DIR"/*; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    other="$(basename "$f")"
    [ "$(dedup_field "$other" submitter)" = "$1" ] || continue
    if kill -0 "$(dedup_field "$other" pid)" 2>/dev/null || "$SYSTEMCTL_BIN" is-active --quiet "$(dedup_field "$other" unit)" 2>/dev/null; then
      n=$((n + 1))
    fi
  done
  echo "$n"
}
dedup_admit() {  # <id> <store> <repo> <branch> <head> <submitter> [jobkey]: 0 recorded, 2 over the submitter's cap
  (
    mkdir -p "$DEDUP_DIR" && chmod 0700 "$DEDUP_DIR" || exit 1
    exec 8>"$DEDUP_DIR/.lock"
    flock 8 || exit 1
    # Fairness: one submitter cannot fill the queue or the slots for the others.
    [ "$(dedup_count_submitter "$6")" -lt "$PER_SUBMITTER_CAP" ] || exit 2
    dedup_register "$1" "${4:+$3/$4}" "$5" "$6" "pneuma-gate-$1.service" "${7:-}" || exit 1
    dedup_supersede "$1" "$2" "${4:+$3/$4}" "$5" "$6"
  )
}

# The bundle must carry the claimed repo and branch, at the head being gated. The runner
# decides supersession by these names, so a client cannot cancel another lane's gate by
# naming its branch: the head it ships must be the head it claims.
bundle_binds() {  # <bundle file> <repo> <branch> <head>
  local heads
  # from /, never the caller's directory: a stray .git there (a worktree's, say) must not decide
  heads="$(cd / && git bundle list-heads "$1" 2>/dev/null)" || return 1
  grep -qx "$4 refs/pneuma-gate/repo/$2" <<< "$heads" && grep -qx "$4 refs/pneuma-gate/branch/$3" <<< "$heads"
}
dedup_remove() { [ -L "$DEDUP_DIR/$1" ] || rm -f "$DEDUP_DIR/$1"; }

# first live waiter in the FIFO queue (dead waiters are dropped as we go)
first_live_waiter() {
  local f
  for f in $(ls "$BASE_DIR/queue" 2>/dev/null | grep -v '^in-' | sort); do
    if kill -0 "${f##*-}" 2>/dev/null; then printf '%s' "$f"; return 0; fi
    rm -f "$BASE_DIR/queue/$f"
  done
}

admit() {   # admit <cores> <mem_mb> — block until admitted; creates RUN_DIR
  local cores="$1" mem="$2" waited=0
  QUEUE_FILE="$BASE_DIR/queue/$(date +%s%N)-$$"; : > "$QUEUE_FILE"
  exec 9>"$BASE_DIR/admit.lock"
  while :; do
    flock 9
    if [ -n "$DEDUP_ID" ] && [ -n "$(dedup_field "$DEDUP_ID" superseded)" ]; then
      flock -u 9; refuse "superseded by $(dedup_field "$DEDUP_ID" superseded)"
    fi
    if [ "$(first_live_waiter)" = "$(basename "$QUEUE_FILE")" ] && can_admit "$cores" "$mem"; then
      RUN_DIR="$BASE_DIR/runs/$(date +%Y%m%dT%H%M%S)-$$"
      mkdir -p "$RUN_DIR/work" "$RUN_DIR/tmp" "$RUN_DIR/home"
      echo $$ > "$RUN_DIR/pid"; echo "$cores" > "$RUN_DIR/cores"; echo "$mem" > "$RUN_DIR/mem_mb"
      if [ -n "$RUN_AS" ]; then chown -R "$RUN_AS" "$RUN_DIR"; fi
      chmod 755 "$RUN_DIR"
      rm -f "$QUEUE_FILE"; QUEUE_FILE=""
      flock -u 9; exec 9>&-
      log "admitted run $(basename "$RUN_DIR") after ${waited}s queued (cores=$cores mem=${mem}MB)"
      return 0
    fi
    flock -u 9
    if [ $((waited % 60)) -eq 0 ]; then
      log "queued: $(live_runs | wc -l) running, no capacity (nproc=$NPROC reserve=$RESERVE_CORES mem_avail=$(mem_available_mb)MB load1=$(awk '{print $1}' "$LOADAVG")) waited ${waited}s"
    fi
    sleep "$POLL_S"; waited=$((waited + POLL_S))
  done
}

ensure_env() {   # ensure_env <profile> <work> → sets ENV_DIR (immutable shared cache)
  local profile="$1" work="$2" key
  key="$(as_gate bash -c 'source "$1"; cd "$2"; profile_env_key' _ "$PROFILE_DIR/$profile.sh" "$work")" || refuse "profile_env_key failed"
  [ -n "$key" ] || refuse "empty environment key"
  ENV_DIR="$BASE_DIR/envs/$profile/$key"
  [ -e "$ENV_DIR/.ready" ] && { log "environment $profile/$key ready (read-only shared cache)"; return 0; }
  mkdir -p "$BASE_DIR/envs/$profile"
  if [ -n "$RUN_AS" ]; then chown "$RUN_AS" "$BASE_DIR/envs/$profile"; fi
  exec 8>"$BASE_DIR/envs/$profile/.build.lock"
  log "environment $profile/$key not cached — waiting for the build lock"
  flock 8
  if [ ! -e "$ENV_DIR/.ready" ]; then
    log "building environment $profile/$key (one-time per dependency set)"
    ( source "$PROFILE_DIR/$profile.sh"; cd "$work" || exit 1
      if declare -F profile_stage_root >/dev/null; then profile_stage_root "$BASE_DIR"; fi ) \
      || { flock -u 8; refuse "profile_stage_root failed"; }
    # Built IN PLACE (venv scripts embed their own path); the .ready marker is
    # written last, so a crashed build is never mistaken for a usable one.
    chmod -R u+w "$ENV_DIR" 2>/dev/null; rm -rf "$ENV_DIR"
    as_gate bash -c 'source "$1"; cd "$2"; export PNEUMA_GATE_BASE="$4"; profile_env_build "$3"' \
      _ "$PROFILE_DIR/$profile.sh" "$work" "$ENV_DIR" "$BASE_DIR" 2>&1 | sed 's/^/  env-build: /'
    if [ "${PIPESTATUS[0]}" -ne 0 ]; then
      chmod -R u+w "$ENV_DIR" 2>/dev/null; rm -rf "$ENV_DIR"; flock -u 8; refuse "environment build failed"
    fi
    as_gate bash -c 'touch "$1/.ready" && chmod -R a-w "$1"' _ "$ENV_DIR" \
      || { flock -u 8; refuse "environment publish failed"; }
  fi
  flock -u 8; exec 8>&-
  log "environment $profile/$key ready (read-only shared cache)"
}

# ── GATE-QUEUE-1: a job outlives its connection; a same-head submission re-attaches ─────────
# A job is a detached worker writing to its own log under jobs/<id>/. The connection only TAILS that log, so
# a dropped ssh loses the stream, never the job or its verdict. A submission for a repo and head that already
# has a LIVE job from the SAME submitter follows that job instead of queueing again. Queued jobs never expire:
# they wait until capacity admits them, or until a newer head or the submitter's own cancel supersedes them.
JOBS_DIR="$BASE_DIR/jobs"
live_job_for_key() {  # <jobkey>: id of a live, unsuperseded job with exactly this scope key (empty when none)
  local f id
  [ -n "$1" ] || return 0
  for f in "$DEDUP_DIR"/*; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    id="$(basename "$f")"
    [ "$(dedup_field "$id" jobkey)" = "$1" ] || continue
    [ -z "$(dedup_field "$id" superseded)" ] || continue
    if kill -0 "$(dedup_field "$id" pid)" 2>/dev/null || "$SYSTEMCTL_BIN" is-active --quiet "$(dedup_field "$id" unit)" 2>/dev/null; then
      echo "$id"; return 0
    fi
  done
  return 0
}
follow_job() {  # <worker pid> <log>: stream the job's log until the job ends; the job keeps running if this drops
  tail -n +1 -f --pid="$1" "$2" 2>/dev/null || true
}
job_exit() {  # <job id>: the exit in the job's ROOT-OWNED result file (75 when there is none: never green).
  # The shared log is never consulted: a log line can be written by anything that can write the log.
  local f="$RESULTS_DIR/$1"
  [ -f "$f" ] && [ ! -L "$f" ] || { echo 75; return 0; }
  sed -n 's/.* exit=\([0-9]*\).*/\1/p' "$f" | head -1
}
cmd_cancel() {  # --repo R --head SHA: cancel THIS submitter's live jobs for that repo and head
  local repo="" head="" n=0
  while [ $# -gt 0 ]; do
    case "$1" in --repo) repo="$2"; shift 2;; --head) head="$2"; shift 2;; *) echo "unknown arg $1" >&2; return 2;; esac
  done
  safe_name "$repo" && [[ "$head" =~ ^[0-9a-f]{40}$ ]] || { echo "refused: cancel needs --repo and a 40-hex --head" >&2; return 2; }
  mkdir -p "$DEDUP_DIR" && chmod 0700 "$DEDUP_DIR" || return 1
  (
    exec 8>"$DEDUP_DIR/.lock"; flock 8 || exit 1
    local f id unit
    for f in "$DEDUP_DIR"/*; do
      [ -f "$f" ] && [ ! -L "$f" ] || continue
      id="$(basename "$f")"
      [[ "$(dedup_field "$id" key)" == "$repo/"* ]] || continue
      [ "$(dedup_field "$id" head)" = "$head" ] || continue
      [ "$(dedup_field "$id" submitter)" = "$SUBMITTER" ] || continue     # only the caller's own jobs
      [ -z "$(dedup_field "$id" superseded)" ] || continue
      dedup_set "$id" superseded "cancelled-by-submitter"
      unit="$(dedup_field "$id" unit)"
      if [ -n "$unit" ]; then "$SYSTEMCTL_BIN" stop "$unit" >/dev/null 2>&1 || true; fi
      n=$((n + 1))
    done
    echo "cancelled $n job(s) for $repo ${head:0:12}"
  )
}

cmd_run() {
  local profile="" repo="" head="" base="" tree="" bundle=0 shallow="" origin_main="" branch="" fwd_env=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --shallow) shallow="$2"; shift 2;;
      --origin-main) origin_main="$2"; shift 2;;
      --env)   # only the gate's own scope knobs may cross the wire
        [[ "$2" =~ ^PNEUMA_PREPUSH_(FULL|NO_CACHE)=[01]$ ]] || { echo "refusing env '$2'" >&2; return 2; }
        fwd_env+=("$2"); shift 2;;
      --profile) profile="$2"; shift 2;; --repo) repo="$2"; shift 2;;
      --head) head="$2"; shift 2;; --base) base="$2"; shift 2;;
      --tree) tree="$2"; shift 2;; --bundle) bundle=1; shift;;
      --branch) branch="$2"; shift 2;;
      *) echo "unknown arg $1" >&2; return 2;;
    esac
  done
  START_TS="$(date +%s)"; R_REPO="$repo"; R_HEAD="$head"; R_TREE="$tree"; R_PROFILE="$profile"
  trap cleanup EXIT
  { safe_name "$repo" && safe_name "$profile"; } || refuse "bad repo/profile name"
  [[ "$head" =~ ^[0-9a-f]{40}$ && "$base" =~ ^[0-9a-f]{40}$ && "$tree" =~ ^[0-9a-f]{40}$ ]] || refuse "head/base/tree must be 40-hex"
  check_host || refuse "host $(hostname) is not the approved builder ($EXPECT_HOST)"
  [ -r "$PROFILE_DIR/$profile.sh" ] || refuse "no gate profile '$profile' in $PROFILE_DIR"
  # GATE-QUEUE-1 / the scope key: every input that defines this verdict's scope is in ONE job key. A live job
  # with the same key is followed, never queued twice; anything that differs (even the base or an env flag) is a new job.
  local env_s; env_s="$(printf '%s\n' "${fwd_env[@]}" | sort | paste -sd, -)"
  JOB_KEY="$(job_key "$repo" "$head" "$tree" "$SUBMITTER" "$profile" "$base" "$origin_main" "$env_s")"
  R_BASE="$base"; R_ORIGIN="$origin_main"; R_ENV="$env_s"; R_SUBMITTER="$SUBMITTER"; R_JOBKEY="$JOB_KEY"
  local live_id; live_id="$(live_job_for_key "$JOB_KEY")"
  if [ -n "$live_id" ]; then
    [ "$bundle" = 1 ] && cat >/dev/null          # the live job already holds this head
    log "attached to live job $live_id (same scope key ${JOB_KEY:0:12}): following it, not queued again"
    follow_job "$(dedup_field "$live_id" pid)" "$JOBS_DIR/$live_id/log"
    return "$(job_exit "$live_id")"
  fi
  install -d -m 0700 "$RESULTS_DIR" 2>/dev/null || refuse "cannot create the results directory $RESULTS_DIR"
  mkdir -p "$BASE_DIR/runs" "$BASE_DIR/repos" "$BASE_DIR/envs" "$BASE_DIR/wheels" "$BASE_DIR/queue" 2>/dev/null \
    || refuse "cannot create $BASE_DIR"
  if [ -n "$RUN_AS" ]; then chown "$RUN_AS" "$BASE_DIR" "$BASE_DIR"/repos "$BASE_DIR"/envs "$BASE_DIR"/queue 2>/dev/null; fi

  cmd_janitor >/dev/null 2>&1   # reap dead runs first so their space counts
  local free; free="$(disk_free_gib)"
  [ -n "$free" ] || refuse "cannot read disk usage for $BASE_DIR"
  [ "$free" -lt "$MIN_FREE_GIB" ] && refuse "disk free ${free}GiB < ${MIN_FREE_GIB}GiB floor — refusing to start"

  # shellcheck disable=SC1090
  source "$PROFILE_DIR/$profile.sh" || refuse "profile $profile failed to load"
  local cores mem; cores="$(profile_cores)"; mem="$(profile_mem_mb)"

  local store; store="$(store_for "$repo")"
  if [ ! -d "$store" ]; then as_gate git init -q --bare "$store" || refuse "cannot init object store"; fi
  # A shallow dev-box clone cannot ship history past its boundary: record the
  # boundary commits so the store (and every workspace) accepts the cut.
  if [ -n "$shallow" ]; then
    { cat "$store/shallow" 2>/dev/null; tr ',' '\n' <<<"$shallow" | grep -E '^[0-9a-f]{40}$'; } |
      sort -u | as_gate tee "$store/shallow.new" >/dev/null && as_gate mv "$store/shallow.new" "$store/shallow"
  fi
  if [ "$bundle" = 1 ]; then
    local bf="$BASE_DIR/queue/in-$$.bundle"
    cat > "$bf"
    if [ -n "$branch" ]; then
      bundle_binds "$bf" "$repo" "$branch" "$head" || refuse "bundle does not carry $repo branch $branch at $head"
    fi
    if [ -n "$RUN_AS" ]; then chown "$RUN_AS" "$bf"; fi
    log "received bundle ($(du -h "$bf" | cut -f1))"
    as_gate git --git-dir="$store" fetch -q "$bf" "refs/pneuma-gate/*:refs/gate-keep/*" 2>&1 | sed 's/^/  fetch: /'
    [ "${PIPESTATUS[0]}" -eq 0 ] || { rm -f "$bf"; refuse "bundle fetch failed"; }
    rm -f "$bf"
  fi
  local o
  [[ -z "$origin_main" || "$origin_main" =~ ^[0-9a-f]{40}$ ]] || refuse "bad --origin-main"
  for o in "$head" "$base" ${origin_main:+"$origin_main"}; do
    as_gate git --git-dir="$store" cat-file -e "${o}^{commit}" 2>/dev/null || refuse "commit $o not in the store (ship a bundle)"
  done
  [ "$(as_gate git --git-dir="$store" rev-parse "${head}^{tree}")" = "$tree" ] || refuse "tree mismatch for $head"

  # the job runs DETACHED: its output goes to its own log and this connection only tails it
  JOB_ID="$(date +%s%N)-$$"
  mkdir -p "$JOBS_DIR/$JOB_ID" && chmod 0750 "$JOBS_DIR/$JOB_ID" && chgrp "${PNEUMA_GATE_SUBMIT_GROUP:-pneuma-submit}" "$JOBS_DIR/$JOB_ID" 2>/dev/null \
    || chmod 0750 "$JOBS_DIR/$JOB_ID" 2>/dev/null || refuse "cannot create the job directory"
  local job_log="$JOBS_DIR/$JOB_ID/log"; : > "$job_log"
  # the job log is readable by the submitter group only (0640); the verdict itself lives in the result file
  chmod 0640 "$job_log"; chgrp "${PNEUMA_GATE_SUBMIT_GROUP:-pneuma-submit}" "$job_log" 2>/dev/null || true
  ( run_job ) >>"$job_log" 2>&1 </dev/null &
  local worker=$!
  log "job $JOB_ID is running detached: a dropped connection no longer loses it"
  follow_job "$worker" "$job_log"
  wait "$worker"; return $?

}

run_job() {   # the detached worker: admission, workspace, the gate, the verdict (its stdout is its log)
  WORKER_PID="$BASHPID"; DEDUP_ID="$JOB_ID"
  trap cleanup EXIT
  # the gate's unit is named after the job: pneuma-gate-<JOB_ID>
  # Every run is recorded under its submitter (the fairness cap applies to all of them). Only a
  # run with a branch has a key, and only a key ever supersedes: a detached run supersedes nothing.
  if [ -n "$branch" ] && ! [[ "$branch" =~ ^[A-Za-z0-9._/-]{1,200}$ ]] || [[ "$branch" == *..* ]]; then
    refuse "bad branch name"
  fi
  log "gate for ${repo:-?} branch ${branch:-(detached)} head ${head:0:12} submitter $SUBMITTER"
  dedup_admit "$DEDUP_ID" "$store" "$repo" "$branch" "$head" "$SUBMITTER" "$JOB_KEY"
  case $? in
    0) ;;
    2) refuse "submitter already holds $PER_SUBMITTER_CAP queued or running gates; wait for them";;
    *) refuse "cannot record the gate";;
  esac
  admit "$cores" "$mem"

  # ── per-run workspace: its own .git, objects via alternates to the store ───
  local work="$RUN_DIR/work"
  as_gate bash -c '
    set -e; cd "$1"; git init -q .; echo "$2/objects" > .git/objects/info/alternates
    if [ -f "$2/shallow" ]; then cp "$2/shallow" .git/shallow; fi
    git update-ref refs/gate/head "$3"; git update-ref refs/gate/base "$4"
    # tests (e.g. the dead-SHA citation guard) resolve origin/main: give the
    # workspace the same one the dev box had, never a guess.
    if [ -n "$5" ]; then git update-ref refs/remotes/origin/main "$5"; fi
    git -c advice.detachedHead=false checkout -q --detach "$3"' _ "$work" "$store" "$head" "$base" "$origin_main" \
    || refuse "workspace checkout failed"
  [ "$(as_gate git -C "$work" rev-parse 'HEAD^{tree}')" = "$tree" ] || refuse "workspace tree mismatch"
  [ -z "$(as_gate git -C "$work" status --porcelain)" ] || refuse "workspace not clean after checkout"
  # Optional profile hook: the scoping decision (diff size, selected services) at
  # the top of the log, so a wrong selection is visible in every verdict.
  if declare -F profile_scope_report >/dev/null; then
    as_gate bash -c 'source "$1"; cd "$2"; profile_scope_report "$3" "$4"' _ \
      "$PROFILE_DIR/$profile.sh" "$work" "$base" "$head" 2>&1 | sed 's/^/  scope: /' || true
  fi

  ENV_DIR=""
  ensure_env "$profile" "$work"

  # ── the gate itself, in a scrubbed environment (no ambient credentials) ────
  local rc scope_bin="${PNEUMA_GATE_SYSTEMD_RUN:-systemd-run}"
  if [ -n "$DEDUP_ID" ] && [ -n "$(dedup_field "$DEDUP_ID" superseded)" ]; then
    result 75 "superseded by $(dedup_field "$DEDUP_ID" superseded)"; return 75
  fi
  # The gate runs as a transient UNIT named by this runner. A newer head cancels it by that
  # name (systemctl stop); no pid is stored or signalled (GATE-DEDUP-1, pid reuse).
  command -v "$scope_bin" >/dev/null 2>&1 || refuse "no $scope_bin: the gate's unit is required"
  "$scope_bin" --unit="pneuma-gate-$DEDUP_ID" --wait --collect --quiet -- \
    ${RUN_AS:+runuser -u "$RUN_AS" --} env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUN_DIR/home" TMPDIR="$RUN_DIR/tmp" LANG=C.UTF-8 \
    PNEUMA_GATE_REMOTE_RUN=1 PNEUMA_GATE_RUN_DIR="$RUN_DIR" PNEUMA_GATE_CORES="$cores" "${fwd_env[@]}" \
    bash -c 'source "$1"; cd "$2"; shift 2; profile_gate "$@"' _ \
    "$PROFILE_DIR/$profile.sh" "$work" "$ENV_DIR" "$head" "$base" "$GATE_TIMEOUT_S" 2>&1 | sed 's/^/gate: /'
  # every gate output line carries the "gate: " prefix, so no line of the gate's own output can ever look like the
  # verdict marker. The verdict's exit is the gate's exit, not the prefix pipe's.
  rc=${PIPESTATUS[0]}
  # the unit's output went to the journal under its unit name: keep it in this verdict's log
  "${JOURNALCTL_BIN:-journalctl}" -u "pneuma-gate-$DEDUP_ID.service" --no-pager -o cat 2>/dev/null | sed 's/^/  gate: /' || true
  if [ -n "$DEDUP_ID" ] && [ -n "$(dedup_field "$DEDUP_ID" superseded)" ]; then
    log "gate superseded by $(dedup_field "$DEDUP_ID" superseded): verdict discarded"
    result 75 "superseded by $(dedup_field "$DEDUP_ID" superseded)"; return 75
  fi
  if [ "$rc" -eq 0 ]; then
    log "gate GREEN"; result 0; return 0
  elif [ "$rc" -eq 124 ]; then
    log "gate TIMED OUT after ${GATE_TIMEOUT_S}s"; result 75 "gate timeout"; return 75
  fi
  log "gate RED (exit $rc)"; result 1; return 1
}

main() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  # Elevated only through pneuma-gate-entry: sudo sets SUDO_USER (env_reset makes it unforgeable by a
  # non-root caller). Any other sudo user is refused. A root shell without sudo is an operator.
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != pneuma-submit ]; then
    echo "pneuma-gate-runner: refused: elevation by '$SUDO_USER' (only pneuma-submit may run the gate)" >&2; exit 75
  fi
  # `--submitter <id>` is placed by pneuma-gate-entry (sshd's forced command), never by a client.
  SUBMITTER=""
  if [ "${1:-}" = --submitter ]; then SUBMITTER="${2:-}"; shift 2; fi
  case "$sub" in
    have) cmd_have "$@";;
    # every verb below requires an identity; there is no shared or empty submitter bucket
    run) [[ "$SUBMITTER" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || refuse_noid; cmd_run "$@"; exit $?;;
    cancel) [[ "$SUBMITTER" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || refuse_noid; cmd_cancel "$@"; exit $?;;
    status) cmd_status;;
    janitor) cmd_janitor;;
    *) echo "usage: pneuma-gate-runner {have|run|cancel|status|janitor}" >&2; exit 2;;
  esac
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
