#!/usr/bin/env bash
# pneuma-gate-runner — runs a repo's pre-push gate for ONE exact commit on the
# dedicated build host (ci-builder), isolated per run, bounded by free capacity.
# Installed to /usr/local/bin by ci-builder-gate.sh; driven over ssh by the dev
# box's pneuma-remote-gate. Repo-specific knowledge lives in gate-profiles/*.sh
# (one file per repo; adding a repo is adding a profile, never editing this).
#
#   pneuma-gate-runner have     --repo R <sha>...   print the commits the host holds
#   pneuma-gate-runner run      --profile P --repo R --head SHA --base SHA --tree T
#                               [--bundle]          (bundle on stdin; log on stdout)
#   pneuma-gate-runner status                       capacity / disk / live runs
#   pneuma-gate-runner janitor                      queue, reservation and staging housekeeping
#   pneuma-gate-runner warm-env --profile P --repo R --ref SHA
#                               publish the dependency env for a TRUSTED ref (operator command)
#   pneuma-gate-runner unit ... / promote ...       internal: run inside the sandboxed units
#
# Verdict contract: the LAST stdout line of `run` is
#   PNEUMA_GATE_RESULT repo=.. head=.. tree=.. exit=N ...
# exit 0 = gate green for exactly that head+tree; 1 = gate RED; 75 = the gate
# did not run to a verdict (refused / queue timeout / infra) — never green.
#
# Isolation (GATE-PG-1). Each gate is a transient systemd SERVICE with DynamicUser=yes (a unique
# uid per run), KillMode=control-group, MemoryMax/CPUQuota/TasksMax/RuntimeMaxSec, PrivateTmp,
# ProtectSystem=strict, ProtectHome, NoNewPrivileges and its own RuntimeDirectory. ALL work on PR
# content happens inside that unit: bundle unpack, checkout, pyproject / key derivation, the
# dependency-env build, the tests and the per-run PostgreSQL. This root runner only places the
# bundle read-only (BindReadOnlyPaths), applies FIXED per-profile limits from the root-owned
# profile (never PR content) and launches. The shared env cache, the object store and the proto
# wheels are read-only to units, so one run cannot poison another's inputs or forge its verdict.
# systemd owns every per-run directory (RuntimeDirectory= and PrivateTmp=): nothing here deletes
# one. The runner NEVER touches k3s, containerd, docker volumes or the GitHub runner services.
set -uo pipefail

BASE_DIR="${PNEUMA_GATE_BASE:-/var/lib/pneuma-gate}"
RUN_ROOT="${PNEUMA_GATE_RUN_ROOT:-/run/pneuma-gate}"   # systemd creates each run's directory here (RuntimeDirectory=)
RUN_AS="${PNEUMA_GATE_RUN_AS-pneuma-gate}"           # owner of the object store; empty = no privilege drop (unit tests only)
PROFILE_DIR="${PNEUMA_GATE_PROFILE_DIR:-/usr/local/lib/pneuma-gate/profiles}"
EXPECT_HOST="${PNEUMA_GATE_EXPECT_HOST-vmi3387590}"   # approved builder identity
ABORT_FREE_GIB="${PNEUMA_GATE_ABORT_FREE_GIB:-35}"      # a running gate is stopped when free space falls below this (the kubelet evicts near ~29GiB; a unit writes at most IO_WRITE_MAX per poll)
DISK_POLL_S="${PNEUMA_GATE_DISK_POLL_S:-1}"
IO_WRITE_MAX="${PNEUMA_GATE_IO_WRITE_MAX:-200M}"          # per-unit write bandwidth cap on the disk that holds the unit's private tmp
IO_DEVICE="${PNEUMA_GATE_IO_DEVICE:-}"                    # block device for the cap; empty = derived from the unit work area; "none" = an explicit, logged opt-out (tests only)
MIN_FREE_GIB="${PNEUMA_GATE_MIN_FREE_GIB:-40}"          # absolute free-space floor on $BASE_DIR's filesystem; ci-builder also runs k3s, whose kubelet evicts below ~10% free (~29GiB of 290GiB) — 40 leaves room for one ~5GiB gate above that line
RESERVE_CORES="${PNEUMA_GATE_RESERVE_CORES:-3}"       # left for runners + k3s
RESERVE_MEM_MB="${PNEUMA_GATE_RESERVE_MEM_MB:-6144}"
MAX_CONCURRENT="${PNEUMA_GATE_MAX_CONCURRENT:-4}"
BUNDLE_MAX_MB="${PNEUMA_GATE_BUNDLE_MAX_MB:-4096}"      # a bundle past this is refused (disk DoS)
QUEUE_TIMEOUT_S="${PNEUMA_GATE_QUEUE_TIMEOUT_S:-10800}"
GATE_TIMEOUT_S="${PNEUMA_GATE_TIMEOUT_S:-5400}"
LOAD_CEILING_PCT="${PNEUMA_GATE_LOAD_CEILING_PCT:-150}" # % of nproc; only blocks stacking a 2nd gate
POLL_S="${PNEUMA_GATE_POLL_S:-5}"
NPROC="${PNEUMA_GATE_NPROC:-$(nproc)}"
MEMINFO="${PNEUMA_GATE_MEMINFO:-/proc/meminfo}"
LOADAVG="${PNEUMA_GATE_LOADAVG:-/proc/loadavg}"
SYSTEMCTL_BIN="${PNEUMA_GATE_SYSTEMCTL:-systemctl}"
SYSTEMD_RUN_BIN="${PNEUMA_GATE_SYSTEMD_RUN:-systemd-run}"
JOURNALCTL_BIN="${PNEUMA_GATE_JOURNALCTL:-journalctl}"
# Where the units see what the runner places for them (bind-mount targets inside the unit).
IN_MOUNT="${PNEUMA_GATE_IN_MOUNT:-/run/pneuma-gate-in}"      # bundle, store/
ENVS_MOUNT="${PNEUMA_GATE_ENVS_MOUNT:-/opt/gate-envs}"       # the profile's env cache (read-only)
UNIT_WORK="${PNEUMA_GATE_UNIT_WORK:-/var/tmp/pneuma-gate}"   # the unit's private disk (PrivateTmp: systemd removes it)
WHEELS_MOUNT="${PNEUMA_GATE_WHEELS_MOUNT:-/opt/gate-wheels}" # staged proto wheels (read-only)
UNIT_PATH="/usr/local/bin:/usr/bin:/bin"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

log() { printf '[gate-runner %s] %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }
as_gate() { if [ -n "$RUN_AS" ]; then runuser -u "$RUN_AS" -- "$@"; else "$@"; fi; }

# ── host identity + disk guard ───────────────────────────────────────────────
check_host() {
  [ -z "$EXPECT_HOST" ] && return 0
  [ "$(hostname)" = "$EXPECT_HOST" ]
}
disk_pct() { df --output=pcent "$BASE_DIR" 2>/dev/null | tail -1 | tr -dc '0-9'; }
# Admission is an ABSOLUTE floor, not a percentage: on a big disk 85% used can
# still leave far more than a gate needs (39G free at 87% used).
disk_free_gib() { df -BG --output=avail "$BASE_DIR" 2>/dev/null | tail -1 | tr -dc '0-9'; }

# ── capacity ─────────────────────────────────────────────────────────────────
mem_available_mb() { awk '/^MemAvailable:/ {print int($2/1024)}' "$MEMINFO"; }
load1_x100() { awk '{printf "%d", $1*100}' "$LOADAVG"; }
# Admission counts, from systemd, the live gate SERVICES with their own configured limits, plus
# the reservations of runners that are alive and have not started their unit yet. Both come from
# root-owned state (systemd, and the 0700 state directory): nothing inside a run directory is read.
# A reservation counts while its runner process is alive (pid + start time, so a recycled pid is
# not mistaken for it), never by age: a slow start does not release capacity.
STATE_DIR="${PNEUMA_GATE_STATE_DIR:-/var/lib/pneuma-gate-state}"

state_init() {
  [ -L "$STATE_DIR" ] && return 1
  mkdir -p "$STATE_DIR/runs" "$STATE_DIR/in" && chmod 0700 "$STATE_DIR" "$STATE_DIR/runs" "$STATE_DIR/in"
}
proc_start() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | awk '{print $20}'; }   # starttime of a pid
state_mark() {  # <run id> <runner pid> <cores> <mem_mb> <queued|admitted|warm> [loopback]: only an admitted marker holds capacity
  local f="$STATE_DIR/runs/$1" tmp="$STATE_DIR/runs/.$1.$$"
  [ -L "$f" ] && return 1
  printf 'pid=%s\npstart=%s\ncores=%s\nmem_mb=%s\nstate=%s\nloopback=%s\n' "$2" "$(proc_start "$2")" "$3" "$4" "${5:-admitted}" "${6:-}" > "$tmp" && mv -f "$tmp" "$f"
}
state_get() {  # <run id> <key>
  local f="$STATE_DIR/runs/$1"
  [ -f "$f" ] && [ ! -L "$f" ] || return 1
  sed -n "s/^$2=//p" "$f" | head -1
}
state_remove() { [ -L "$STATE_DIR/runs/$1" ] || rm -f "$STATE_DIR/runs/$1"; }
# Liveness is three-valued. "dead" needs POSITIVE proof (the pid is not in /proc, or it is there with a
# different start time); anything that cannot be parsed or read is "unknown", and unknown counts as
# OCCUPIED: it holds its slot and its place, and only a positive "dead" lets a reservation, a ticket or a
# record be reclaimed. A slot is never freed because its owner could not be examined.
proc_state() {  # <pid> <pstart>: alive | dead | unknown
  local pid="$1" pstart="$2" now
  case "$pid" in ''|*[!0-9]*) echo unknown; return;; esac
  [ -r /proc/self/stat ] || { echo unknown; return; }          # /proc itself is not usable: cannot tell
  if [ ! -e "/proc/$pid" ]; then echo dead; return; fi          # no such process: positive proof
  [ -n "$pstart" ] || { echo unknown; return; }
  now="$(proc_start "$pid")"
  [ -n "$now" ] || { echo unknown; return; }
  if [ "$now" = "$pstart" ]; then echo alive; else echo dead; fi   # same pid, another start time: recycled
}
unit_state() {  # <unit>: active | inactive | unknown (systemctl is-active's own words; anything else is unknown)
  local out; out="$("$SYSTEMCTL_BIN" is-active "$1" 2>/dev/null)"
  case "$out" in
    active|activating|deactivating|reloading|refreshing) echo active;;
    inactive|failed) echo inactive;;
    *) echo unknown;;
  esac
}
ticket_state() {  # <ticket file>: its content is "<pid> <start time>"
  local pid pstart
  read -r pid pstart < "$1" 2>/dev/null || { echo unknown; return; }
  proc_state "$pid" "$pstart"
}
runner_state() {  # <run id>: the runner that holds this reservation
  local f="$STATE_DIR/runs/$1"
  [ -L "$f" ] && { echo unknown; return; }
  [ -e "$f" ] || { echo dead; return; }                          # no record at all: nothing holds it
  [ -f "$f" ] || { echo unknown; return; }
  proc_state "$(state_get "$1" pid)" "$(state_get "$1" pstart)"
}
runner_alive() { [ "$(runner_state "$1")" = alive ]; }
runner_dead() { [ "$(runner_state "$1")" = dead ]; }

live_runs() {   # prints "<id> <cores> <mem_mb>"
  local unit id cores mem active f quota bytes
  # If the units cannot be listed the capacity is UNKNOWN, not zero: fail (admission then refuses).
  active="$("$SYSTEMCTL_BIN" list-units --plain --no-legend --state=active,activating,deactivating 'pneuma-gate-*.service' 2>/dev/null)" || return 1
  active="$(awk '{print $1}' <<<"$active")"
  while read -r unit; do
    [ -n "$unit" ] || continue
    id="${unit#pneuma-gate-}"; id="${id%.service}"
    quota="$("$SYSTEMCTL_BIN" show -p CPUQuotaPerSecUSec --value "$unit" 2>/dev/null)"
    bytes="$("$SYSTEMCTL_BIN" show -p MemoryMax --value "$unit" 2>/dev/null)"
    # a quota that cannot be read is charged as the whole host, never as the smallest unit
    cores="$(awk -v q="$quota" -v all="$NPROC" 'BEGIN { sub(/s$/, "", q); if (q !~ /^[0-9]+(\.[0-9]+)?$/) { print all; exit } c = int(q + 0.5); if (c < 1) c = 1; print c }')"
    case "$bytes" in ''|*[!0-9]*) mem=0;; *) mem=$(( bytes / 1048576 ));; esac
    printf '%s %s %s\n' "$id" "$cores" "$mem"
  done <<< "$active"
  [ -d "$STATE_DIR/runs" ] || return 0
  for f in "$STATE_DIR"/runs/*; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    id="$(basename "$f")"
    grep -qx "pneuma-gate-$id.service" <<< "$active" && continue   # its unit is counted already
    runner_dead "$id" && continue            # only a positively dead runner releases its reservation
    case "$(state_get "$id" state)" in queued|warm) continue;; esac   # staged and waiting, or an operator build: holds no gate capacity
    cores="$(state_get "$id" cores)"; case "$cores" in ''|*[!0-9]*) cores="$NPROC";; esac   # unreadable weight = the whole host
    printf '%s %s %s\n' "$id" "$cores" "$(state_get "$id" mem_mb)"
  done
}

can_admit() {
  local cores="$1" mem="$2" n=0 used_c=0 id c m
  while read -r id c m; do
    [ -n "$id" ] || continue
    [ "$id" = LIVE-RUNS-UNKNOWN ] && return 1          # the units could not be listed: nothing is known to be free
    case "$c" in ''|*[!0-9]*) c="$NPROC";; esac
    n=$((n + 1)); used_c=$((used_c + c))
  done < <(live_runs || echo "LIVE-RUNS-UNKNOWN 0 0")
  [ "$n" -ge "$MAX_CONCURRENT" ] && return 1
  # Core budget = cores minus the reserve; one gate is always allowed to use
  # its own weight so a tiny host still makes progress.
  local budget=$((NPROC - RESERVE_CORES))
  [ "$budget" -lt "$cores" ] && budget="$cores"
  [ $((used_c + cores)) -gt "$budget" ] && return 1
  # Memory: what is available NOW (already net of live gates) minus the reserve.
  [ $(($(mem_available_mb) - RESERVE_MEM_MB)) -lt "$mem" ] && return 1
  # Load: when the host is already saturated by runners/k3s, only the first
  # gate may start (never stack gates on a starved box).
  local load; load="$(load1_x100)"; case "$load" in ''|*[!0-9]*) load=999999999;; esac   # unreadable load = saturated
  if [ "$n" -gt 0 ] && [ "$load" -gt $((NPROC * LOAD_CEILING_PCT)) ]; then return 1; fi
  return 0
}

# ── repo store ───────────────────────────────────────────────────────────────
safe_name() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] && [ "$1" != . ] && [ "$1" != .. ]; }
store_for() { printf '%s/repos/%s.git' "$BASE_DIR" "$1"; }

cmd_have() {
  local repo="" shas=()
  while [ $# -gt 0 ]; do
    case "$1" in --repo) repo="$2"; shift 2;; *) shas+=("$1"); shift;; esac
  done
  safe_name "$repo" || { echo "bad repo" >&2; return 2; }
  local store; store="$(store_for "$repo")"
  [ -d "$store" ] || return 0
  printf '%s\n' "${shas[@]}" | as_gate git --git-dir="$store" cat-file --batch-check='%(objectname) %(objecttype)' 2>/dev/null | awk '$2=="commit"{print $1}'
}

command -v "$SYSTEMCTL_BIN" >/dev/null 2>&1 || { echo "pneuma-gate-runner: no systemctl ($SYSTEMCTL_BIN): admission and the gate unit need systemd" >&2; exit 75; }

# ── janitor ──────────────────────────────────────────────────────────────────
cmd_janitor() {
  # Housekeeping only. Nothing here deletes a run directory or stops a unit: systemd owns both
  # (RuntimeDirectory=, PrivateTmp=, KillMode=control-group). This removes the root runner's own
  # leftovers: queue entries and reservation markers of dead runners, staged bundles whose unit is
  # not running, and keep-refs past two days.
  local f pid store ref ts id
  cmd_guard
  loopback_sweep
  for f in "$BASE_DIR"/queue/*; do
    [ -e "$f" ] || continue
    [ "$(ticket_state "$f")" = dead ] && rm -f "$f"     # unknown stays: only a positive death frees a place
  done
  for f in "$STATE_DIR"/runs/*; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    id="$(basename "$f")"
    runner_dead "$id" || continue
    [ "$(unit_state "pneuma-gate-$id.service")" = inactive ] || continue
    rm -f "$f"
  done
  for f in "$STATE_DIR"/in/*; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    id="$(basename "$f" .bundle)"
    [ -f "$STATE_DIR/runs/$id" ] && continue
    runner_dead "$id" || continue    # a queued runner has staged its bundle (its marker is "queued")
    [ "$(unit_state "pneuma-gate-$id.service")" = inactive ] || continue
    rm -f "$f"
  done
  # keep-refs older than 2 days no longer pin their objects
  for store in "$BASE_DIR"/repos/*.git; do
    [ -d "$store" ] || continue
    as_gate git --git-dir="$store" for-each-ref --format='%(refname) %(committerdate:unix)' refs/gate-keep 2>/dev/null |
      while read -r ref ts; do
        [ $(($(date +%s) - ts)) -gt 172800 ] && as_gate git --git-dir="$store" update-ref -d "$ref"
      done
  done
  return 0
}

# Units nobody supervises, and every unit when the disk is low. Runs from the janitor and from
# cron every minute, so the runner's own 1s guard is not the only line: a SIGKILLed runner leaves
# its unit running (bounded only by RuntimeMaxSec) with no one watching the disk.
cmd_guard() {
  local unit id free low=0
  free="$(disk_free_gib)"
  { [ -n "$free" ] && [ "$free" -lt "$ABORT_FREE_GIB" ]; } && low=1
  while read -r unit; do
    [ -n "$unit" ] || continue
    id="${unit#pneuma-gate-}"; id="${id%.service}"
    if [ "$low" = 1 ] || runner_dead "$id"; then
      log "guard: stopping $unit (${low:+disk low or }runner gone)"
      "$SYSTEMCTL_BIN" stop "$unit" >/dev/null 2>&1
    fi
  done < <("$SYSTEMCTL_BIN" list-units --plain --no-legend --state=active,activating,deactivating 'pneuma-gate-*.service' 2>/dev/null | awk '{print $1}')
  return 0
}

cmd_status() {
  echo "host=$(hostname) nproc=$NPROC mem_available_mb=$(mem_available_mb) load1=$(awk '{print $1}' "$LOADAVG") disk_pct=$(disk_pct) disk_free_gib=$(disk_free_gib)"
  echo "limits: disk_free>=${MIN_FREE_GIB}GiB reserve_cores=$RESERVE_CORES reserve_mem_mb=$RESERVE_MEM_MB max_concurrent=$MAX_CONCURRENT"
  if [ "$IO_DEVICE" = none ]; then echo "io-cap: DISABLED (PNEUMA_GATE_IO_DEVICE=none)"
  elif [ -n "$(io_device)" ]; then echo "io-cap: $(io_device) $IO_WRITE_MAX"
  else echo "io-cap: NONE (the unit disk is not a block device; set PNEUMA_GATE_IO_DEVICE)"; fi
  live_runs | sed 's/^/live-run: /'
}

# The mount points the units' bind mounts land on, made here (idempotently, as root) so a unit's
# start never depends on systemd creating them under a read-only /run.
bind_points() {
  mkdir -p "$IN_MOUNT/store" "$ENVS_MOUNT" "$WHEELS_MOUNT" 2>/dev/null
  [ -e "$IN_MOUNT/bundle" ] || : > "$IN_MOUNT/bundle" 2>/dev/null
  return 0
}

# ── the sandbox every unit gets ──────────────────────────────────────────────
# A unique uid per run (DynamicUser), a read-only filesystem except its own directories, no
# privilege gain, no devices, no kernel knobs, other runs' processes invisible.
SANDBOX_PROPS=(
  --property=DynamicUser=yes --property=KillMode=control-group
  --property=PrivateTmp=yes --property=ProtectSystem=strict --property=ProtectHome=yes
  --property=NoNewPrivileges=yes --property=PrivateDevices=yes --property=ProtectProc=invisible
  --property=ProtectKernelTunables=yes --property=ProtectKernelModules=yes
  --property=ProtectControlGroups=yes --property=RestrictSUIDSGID=yes --property=LockPersonality=yes
  --property=RemoveIPC=yes --property=MemorySwapMax=0 --property=TimeoutStopSec=20
)

# The network a unit may use: the public internet a cache-miss env build needs (PyPI, npm, nodejs.org),
# the system's DNS resolvers, and ONE per-run loopback address for the run's own PostgreSQL. Not
# allowed: 127.0.0.1 and the rest of loopback (k3s API, kubelet), RFC1918/CGNAT/link-local (wg0, pod and
# docker networks), and every address configured on this host (so its public address does not loop back
# to host-local services). Deny-by-default; the allow list is the complement of those ranges.
net_allow_list() {   # <per-run loopback address> → space separated CIDRs
  local confs="${PNEUMA_GATE_RESOLV_CONFS:-/etc/resolv.conf /run/systemd/resolve/resolv.conf}" resolvers
  # shellcheck disable=SC2086
  resolvers="$(cat $confs 2>/dev/null | awk '$1=="nameserver"{print $2}' | tr '\n' ' ')"
  # Every IPv4 token of every address line (local, peer and broadcast addresses alike: a point-to-point
  # tunnel line carries a "peer" address that is just as host-local), as /32 exclusions.
  "$IP_BIN" -4 -o addr show 2>/dev/null |
    python3 -c '
import ipaddress, re, sys
lo, resolvers = sys.argv[1], sys.argv[2].split()
local = set()
for line in sys.stdin:
    for tok in re.findall(r"\b\d{1,3}(?:\.\d{1,3}){3}\b", line):
        try:
            local.add(ipaddress.ip_address(tok))
        except ValueError:
            pass
excl = [ipaddress.ip_network(n) for n in (
    "0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8", "169.254.0.0/16", "172.16.0.0/12",
    "192.0.0.0/24", "192.168.0.0/16", "198.18.0.0/15", "224.0.0.0/3")]
excl += [ipaddress.ip_network(f"{a}/32") for a in local]
nets = [ipaddress.ip_network("0.0.0.0/0")]
for e in excl:
    nxt = []
    for n in nets:
        if not n.overlaps(e):
            nxt.append(n)
        elif e.subnet_of(n):
            nxt.extend(n.address_exclude(e) if e != n else [])
        # else: n is inside e, dropped
    nets = nxt
out = [str(n) for n in ipaddress.collapse_addresses(nets)]
# A resolver is reachable on every port, so only one that is not this host qualifies: not one of the host
# own addresses, and on loopback only the systemd-resolved stub (127.0.0.53, DNS only). A resolver on
# 127.0.0.1 would open the host-local services; DNS then fails loudly instead.
for r in resolvers:
    try:
        ip = ipaddress.ip_address(r)
    except ValueError:
        continue
    if ip.version != 4 or ip in local:
        continue
    if ip.is_loopback and str(ip) != "127.0.0.53":
        continue
    out.append(f"{ip}/32")
out.append(f"{lo}/32")
print(" ".join(out))' "$1" "$resolvers"
}
run_loopback() {   # <run id> → a loopback address no other run uses and that is not 127.0.0.1
  local h; h="$(printf '%s' "$1" | cksum | cut -d' ' -f1)"
  printf '127.%d.%d.%d' $((16 + h % 200)) $((h / 200 % 250 + 1)) $((h / 50000 % 250 + 1))
}
# A client connecting to 127.x.y.z is sourced from 127.0.0.1 by default, and the unit's network filter
# (rightly) does not allow 127.0.0.1. A host route per run makes the source the run's own address, so
# only that address is ever used on loopback. Removed with the run; the janitor sweeps the stale ones.
IP_BIN="${PNEUMA_GATE_IP:-ip}"
loopback_claim() {   # <run id> → prints a per-run loopback address that no other run holds, route in place
  local i addr
  for i in 0 1 2 3 4 5 6 7; do
    addr="$(run_loopback "$1.$i")"
    # `route add` (not replace) fails when the address is already routed: a collision with another run
    if "$IP_BIN" route add local "$addr/32" dev lo scope host src "$addr" 2>/dev/null; then printf '%s' "$addr"; return 0; fi
  done
  return 1
}
loopback_down() { "$IP_BIN" route del local "$1/32" dev lo >/dev/null 2>&1; return 0; }
loopback_sweep() {   # drop the per-run routes of runs that are gone
  local keep="" r addr
  for r in "$STATE_DIR"/runs/*; do
    [ -f "$r" ] && [ ! -L "$r" ] || continue
    runner_dead "$(basename "$r")" && continue
    keep="$keep"$'\n'"$(state_get "$(basename "$r")" loopback)"
  done
  "$IP_BIN" route show table local 2>/dev/null | awk '$1=="local" && $2 ~ /^127\.(1[6-9]|[2-9][0-9]|1[0-9][0-9]|2[01][0-9])\.[0-9]+\.[0-9]+$/ {print $2}' |
    while read -r addr; do grep -qxF "$addr" <<<"$keep" || loopback_down "$addr"; done
  return 0
}
io_device() {   # the block device that holds the units' private disk; nothing when it is not one
  local dev="$IO_DEVICE"
  [ -n "$dev" ] || dev="$(findmnt -no SOURCE -T /var/tmp 2>/dev/null)"
  [ -b "$dev" ] && printf '%s' "$dev"
}
# the properties every gate/warm unit gets besides the sandbox: no network but the allow list, a
# write-bandwidth cap on the disk, and a filesystem view without the gate's other state
unit_props() {   # <loopback> → UNIT_PROPS
  local allow dev
  allow="$(net_allow_list "$1")" || return 1
  [ -n "$allow" ] || return 1
  UNIT_PROPS=(--property=IPAddressDeny=any --property=IPAddressAllow="$allow"
              --property=TemporaryFileSystem="$BASE_DIR:ro" --property=TemporaryFileSystem="$STATE_DIR:ro")
  # The write cap is part of the disk guard's arithmetic (the burst after the abort line). A host whose
  # unit disk does not resolve to a block device must FAIL loudly, never run without the cap.
  if [ "$IO_DEVICE" = none ]; then
    log "WARNING: the write-bandwidth cap is disabled by PNEUMA_GATE_IO_DEVICE=none"
  else
    dev="$(io_device)"
    if [ -z "$dev" ]; then
      echo "pneuma-gate-runner: no block device for the unit disk (/var/tmp is on '$(findmnt -no SOURCE -T /var/tmp 2>/dev/null)'); set PNEUMA_GATE_IO_DEVICE=/dev/<disk>: refusing to run without IOWriteBandwidthMax" >&2
      return 1
    fi
    UNIT_PROPS+=(--property=IOWriteBandwidthMax="$dev $IO_WRITE_MAX")
  fi
  return 0
}

# ── run ──────────────────────────────────────────────────────────────────────
DEDUP_ID=""; SUBMITTER=""; LOOPBACK=""; RUN_ID=""; QUEUE_FILE=""; START_TS=0; BUNDLE_FILE=""; UNIT=""; GUARD_PID=""; ABORT_FLAG=""
R_REPO=""; R_HEAD=""; R_TREE=""; R_PROFILE=""
refuse() { log "REFUSED: $1"; result 75 "$1"; exit 75; }
result() {   # result <exit> [reason]
  printf 'PNEUMA_GATE_RESULT repo=%s head=%s tree=%s profile=%s exit=%s elapsed=%ss host=%s%s\n' \
    "$R_REPO" "$R_HEAD" "$R_TREE" "$R_PROFILE" "$1" "$(($(date +%s) - START_TS))" "$(hostname)" "${2:+ reason=\"$2\"}"
}

refuse_noid() { echo "pneuma-gate-runner: refused: no submitter identity (only pneuma-gate-entry forces one)" >&2; exit 75; }

# GATE-DEDUP-1. A gate for a repo and branch makes every older gate of that branch unusable.
# Each run is recorded under a root-only directory with its key (repo/branch, never a SHA
# prefix), its head, its SUBMITTER, its runner pid and its unit. A newer head supersedes the
# older live runs of the SAME submitter and the SAME key:
#   - a queued run refuses at its next admission poll;
#   - a running run is cancelled by its UNIT NAME (systemctl stop). No stored pid is ever
#     signalled: a pid can be reused by an unrelated process.
# The submitter is the SSH key the client authenticated with, read by this ROOT runner from
# sshd's own auth record (ExposeAuthInfo). It is never a field the client supplies. When it is
# unknown, the run neither supersedes nor is superseded: the fail-safe is to cancel nothing.
DEDUP_DIR="${PNEUMA_GATE_DEDUP_DIR:-/var/lib/pneuma-gate-dedup}"
PER_SUBMITTER_CAP="${PNEUMA_GATE_PER_SUBMITTER_CAP:-3}"   # live gates one submitter may hold at once (queued + running)
dedup_register() {  # <id> <key> <head> <submitter> <unit>
  mkdir -p "$DEDUP_DIR" && chmod 0700 "$DEDUP_DIR" || return 1
  printf 'key=%s\nhead=%s\npid=%s\npstart=%s\nsubmitter=%s\nunit=%s\nsuperseded=\n' "$2" "$3" "$$" "$(proc_start "$$")" "$4" "$5" > "$DEDUP_DIR/$1"
}
# A record is live while its runner is the SAME process (pid + start time, so a recycled pid is not
# mistaken for it) or its unit is active. A record without a start time (older runner) falls back to the pid.
dedup_state() {  # <id>: alive | dead | unknown; dead needs the runner AND the unit both positively gone
  local pid pstart ps us
  pid="$(dedup_field "$1" pid)"; pstart="$(dedup_field "$1" pstart)"
  # a record without a start time (older runner) is judged by the pid alone: present is alive, absent is dead
  if [ -n "$pid" ] && [ -z "$pstart" ] && [[ "$pid" =~ ^[0-9]+$ ]]; then
    if [ -e "/proc/$pid" ]; then ps=alive; else ps=dead; fi
  else
    ps="$(proc_state "$pid" "$pstart")"
  fi
  us="$(unit_state "$(dedup_field "$1" unit)")"
  [ "$ps" = alive ] || [ "$us" = active ] && { echo alive; return; }
  if [ "$ps" = dead ] && [ "$us" = inactive ]; then echo dead; else echo unknown; fi
}
dedup_alive() { [ "$(dedup_state "$1")" != dead ]; }    # unknown counts as live (occupied)
dedup_field() {  # <id> <field>
  local f="$DEDUP_DIR/$1"
  [ -f "$f" ] && [ ! -L "$f" ] || return 0
  sed -n "s/^$2=//p" "$f" | head -1
}
dedup_set() { [ -f "$DEDUP_DIR/$1" ] && [ ! -L "$DEDUP_DIR/$1" ] && sed -i "s/^$2=.*/$2=$3/" "$DEDUP_DIR/$1"; }
dedup_supersede() {  # <id> <store> <key> <head> <submitter>
  [ -n "$3" ] || return 0                     # no key (a detached run): nothing is superseded
  # Supersede the live runs of THIS key that the SAME submitter sent, when this head is a
  # DESCENDANT of theirs (or the two diverge: a force-push, the newest wins, and it is logged).
  # An older commit never cancels a newer one. Unknown ancestry, or an unknown submitter, cancels nothing.
  local store="$2" f other old unit
  [ -n "$5" ] || return 0
  for f in "$DEDUP_DIR"/*; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    other="$(basename "$f")"
    [ "$other" = "$1" ] && continue
    [ "$(dedup_field "$other" key)" = "$3" ] || continue           # the repo AND the branch
    [ "$(dedup_field "$other" submitter)" = "$5" ] || continue     # never another submitter's gate
    old="$(dedup_field "$other" head)"
    [ "$old" = "$4" ] && continue
    case "$(dedup_state "$other")" in
      dead) rm -f "$f"; continue;;             # both its runner and its unit are positively gone
      alive) ;;
      *) log "not superseding run $other: its liveness is unknown"; continue;;   # unknown: cancel nothing, delete nothing
    esac
    if git --git-dir="$store" merge-base --is-ancestor "$4" "$old" 2>/dev/null; then
      log "not superseding run $other: head ${4:0:12} is older than its head ${old:0:12}"
      continue                                  # an older commit never cancels a newer gate
    fi
    if git --git-dir="$store" merge-base --is-ancestor "$old" "$4" 2>/dev/null; then
      log "superseded run $other (head ${old:0:12}) by descendant ${4:0:12}"
    elif git --git-dir="$store" cat-file -e "$old^{commit}" 2>/dev/null; then
      log "superseded run $other (head ${old:0:12}) by ${4:0:12}: the heads DIVERGE (force-push); the newest submission wins"
    else
      log "not superseding run $other: its head ${old:0:12} is unknown to the store"
      continue                                  # unknown ancestry: fail safe, cancel nothing
    fi
    dedup_set "$other" superseded "$4"
    unit="$(dedup_field "$other" unit)"
    if [ -n "$unit" ]; then "$SYSTEMCTL_BIN" stop "$unit" >/dev/null 2>&1 || true; fi
  done
}

# The admission decision for a submission: record it and supersede under ONE root lock, so
# two simultaneous submissions cannot each miss the other (the later one wins). The lock lives
# in a subshell whose fd dies with it, so no gate code ever runs while it is open.
dedup_count_submitter() {  # <submitter>: live gates (queued or running) that submitter holds
  local f other n=0
  for f in "$DEDUP_DIR"/*; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    other="$(basename "$f")"
    [ "$(dedup_field "$other" submitter)" = "$1" ] || continue
    if dedup_alive "$other"; then n=$((n + 1)); fi
  done
  echo "$n"
}
# The two halves of the admission decision, each under the root lock. HOLD runs first thing in a run: it
# enforces the submitter's cap and records the run, before the runner reads a byte of the bundle, promotes
# anything or touches the store, so an over-cap submitter costs the host nothing. DECIDE runs once the bundle
# is in the store (ancestry needs it) and supersedes the older gates.
dedup_hold() {  # <id> <repo> <branch> <head> <submitter>: 0 recorded, 2 over the submitter's cap
  (
    mkdir -p "$DEDUP_DIR" && chmod 0700 "$DEDUP_DIR" || exit 1
    exec 8>"$DEDUP_DIR/.lock"
    flock 8 || exit 1
    [ "$(dedup_count_submitter "$5")" -lt "$PER_SUBMITTER_CAP" ] || exit 2
    dedup_register "$1" "${3:+$2/$3}" "$4" "$5" "pneuma-gate-$1.service" || exit 1
  )
}
dedup_decide() {  # <id> <store> <repo> <branch> <head> <submitter>
  (
    exec 8>"$DEDUP_DIR/.lock"
    flock 8 || exit 1
    dedup_supersede "$1" "$2" "${4:+$3/$4}" "$5" "$6"
  )
}
dedup_admit() {  # <id> <store> <repo> <branch> <head> <submitter>: 0 recorded, 2 over the submitter's cap
  (
    mkdir -p "$DEDUP_DIR" && chmod 0700 "$DEDUP_DIR" || exit 1
    exec 8>"$DEDUP_DIR/.lock"
    flock 8 || exit 1
    # Fairness: one submitter cannot fill the queue or the slots for the others.
    [ "$(dedup_count_submitter "$6")" -lt "$PER_SUBMITTER_CAP" ] || exit 2
    dedup_register "$1" "${4:+$3/$4}" "$5" "$6" "pneuma-gate-$1.service" || exit 1
    dedup_supersede "$1" "$2" "${4:+$3/$4}" "$5" "$6"
  )
}

# The bundle must carry the claimed repo and branch, at the head being gated. The runner
# decides supersession by these names, so a client cannot cancel another lane's gate by
# naming its branch: the head it ships must be the head it claims.
bundle_binds() {  # <bundle file> <repo> <branch> <head>
  local heads
  # from /, never the caller's directory: a stray .git there (a worktree's, say) must not decide
  heads="$(cd / && git bundle list-heads "$1" 2>/dev/null)" || return 1
  grep -qxF "$4 refs/pneuma-gate/repo/$2" <<< "$heads" && grep -qxF "$4 refs/pneuma-gate/branch/$3" <<< "$heads"
}
dedup_remove() { [ -L "$DEDUP_DIR/$1" ] || rm -f "$DEDUP_DIR/$1"; }

first_live_waiter() {
  local f
  for f in $(ls "$BASE_DIR/queue" 2>/dev/null | sort); do
    case "$(ticket_state "$BASE_DIR/queue/$f")" in
      alive) printf '%s' "$f"; return 0;;
      dead) rm -f "$BASE_DIR/queue/$f";;
    esac
  done
}

admit() {   # admit <cores> <mem_mb>: block until this run holds a reservation
  local cores="$1" mem="$2" waited=0
  QUEUE_FILE="$BASE_DIR/queue/$(date +%s%N)-$$"; printf '%s %s\n' "$$" "$(proc_start $$)" > "$QUEUE_FILE"
  while :; do
    if [ -n "$DEDUP_ID" ] && [ -n "$(dedup_field "$DEDUP_ID" superseded)" ]; then
      refuse "superseded by $(dedup_field "$DEDUP_ID" superseded)"
    fi
    if reserve_capacity "$cores" "$mem"; then break; fi
    if [ $((waited % 60)) -eq 0 ]; then
      log "queued: $(live_runs | wc -l) running, no capacity (nproc=$NPROC reserve=$RESERVE_CORES mem_avail=$(mem_available_mb)MB load1=$(awk '{print $1}' "$LOADAVG")) waited ${waited}s"
    fi
    [ "$waited" -ge "$QUEUE_TIMEOUT_S" ] && refuse "queue timeout after ${waited}s"
    sleep "$POLL_S"; waited=$((waited + POLL_S))
  done
  rm -f "$QUEUE_FILE"; QUEUE_FILE=""
  log "admitted run $RUN_ID after ${waited}s queued (cores=$cores mem=${mem}MB)"
}

# The admission lock covers only the decision and the reservation marker. It lives in a
# subshell whose fd dies with it, so no gate code ever runs while the lock is open.
reserve_capacity() {   # <cores> <mem_mb>: 0 when this run holds a reservation
  local cores="$1" mem="$2"
  (
    exec 9>"$BASE_DIR/admit.lock"
    flock 9 || exit 1
    [ "$(first_live_waiter)" = "$(basename "$QUEUE_FILE")" ] || exit 1
    can_admit "$cores" "$mem" || exit 1
    state_mark "$RUN_ID" "$$" "$cores" "$mem" admitted "$LOOPBACK" || exit 1
  )
}

# The runner's own leftovers only: the queue entry, the staged bundle and the reservation. The
# per-run directories belong to systemd and go with the unit.
cleanup() {
  [ -n "$QUEUE_FILE" ] && rm -f "$QUEUE_FILE"
  [ -n "$BUNDLE_FILE" ] && rm -f "$BUNDLE_FILE"
  [ -n "$DEDUP_ID" ] && dedup_remove "$DEDUP_ID"
  [ -n "$LOOPBACK" ] && loopback_down "$LOOPBACK"
  [ -n "$GUARD_PID" ] && kill "$GUARD_PID" 2>/dev/null
  [ -n "$ABORT_FLAG" ] && rm -f "$ABORT_FLAG"
  [ -n "$RUN_ID" ] && state_remove "$RUN_ID"
}
# A gate's private disk (workspace, env, PG data, venv) is bounded only by the host: while the
# unit runs, stop it if free space on the builder falls to the abort line, so one run cannot
# starve k3s or the other runs. The flag file tells the verdict this was an abort, not a failure.
disk_guard() {   # <unit> <flag>
  while sleep "$DISK_POLL_S"; do
    local free; free="$(disk_free_gib)"
    if [ -n "$free" ] && [ "$free" -lt "$ABORT_FREE_GIB" ]; then
      : > "$2"; "$SYSTEMCTL_BIN" stop "$1.service" >/dev/null 2>&1; return 0
    fi
  done
}
# An abandoned run (ssh gone, runner told to stop) must not keep its capacity: stop its unit.
abandon() { [ -n "$UNIT" ] && "$SYSTEMCTL_BIN" stop "$UNIT.service" >/dev/null 2>&1; exit 75; }

# Promote the received bundle into the shared object store so later bundles can be incremental.
# Only this sandboxed unit (the static store owner, no network, writable store only) ever writes
# the store: a gate unit cannot, so a run cannot alter an object another run will read.
promote_bundle() {   # <store> <bundle> <shallow>
  local store="$1" bundle="$2" shallow="$3" user_args=()
  [ -n "$RUN_AS" ] && user_args=(--property=User="$RUN_AS")
  "$SYSTEMD_RUN_BIN" --unit="pneuma-promote-$RUN_ID" --wait --collect --quiet "${user_args[@]}" \
    --property=KillMode=control-group --property=PrivateTmp=yes --property=ProtectSystem=strict \
    --property=ProtectHome=yes --property=NoNewPrivileges=yes --property=PrivateNetwork=yes \
    --property=PrivateDevices=yes --property=ReadWritePaths="$store" \
    --property=BindReadOnlyPaths="$bundle:$IN_MOUNT/bundle" \
    --property=MemoryMax=2G --property=CPUQuota=100% --property=TasksMax=64 --property=RuntimeMaxSec=900 -- \
    env -i PATH="$UNIT_PATH" HOME=/nonexistent LANG=C.UTF-8 \
    "$SELF" promote --store "$store" --bundle "$IN_MOUNT/bundle" --shallow "$shallow" </dev/null 2>&1 | sed 's/^/  promote: /'
}

cmd_run() {
  local profile="" repo="" head="" base="" tree="" bundle=0 shallow="" origin_main="" branch="" fwd_env=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --shallow) shallow="$2"; shift 2;;
      --origin-main) origin_main="$2"; shift 2;;
      --env)   # only the gate's own scope knobs may cross the wire
        [[ "$2" =~ ^PNEUMA_PREPUSH_(FULL|NO_CACHE)=[01]$ ]] || { echo "refusing env '$2'" >&2; return 2; }
        fwd_env+=("$2"); shift 2;;
      --profile) profile="$2"; shift 2;; --repo) repo="$2"; shift 2;;
      --head) head="$2"; shift 2;; --base) base="$2"; shift 2;;
      --tree) tree="$2"; shift 2;; --bundle) bundle=1; shift;;
      --branch) branch="$2"; shift 2;;
      *) echo "unknown arg $1" >&2; return 2;;
    esac
  done
  START_TS="$(date +%s)"; R_REPO="$repo"; R_HEAD="$head"; R_TREE="$tree"; R_PROFILE="$profile"
  trap cleanup EXIT
  trap abandon HUP TERM INT
  { safe_name "$repo" && safe_name "$profile"; } || refuse "bad repo/profile name"
  [[ "$head" =~ ^[0-9a-f]{40}$ && "$base" =~ ^[0-9a-f]{40}$ && "$tree" =~ ^[0-9a-f]{40}$ ]] || refuse "head/base/tree must be 40-hex"
  [[ -z "$origin_main" || "$origin_main" =~ ^[0-9a-f]{40}$ ]] || refuse "bad --origin-main"
  [[ -z "$shallow" || "$shallow" =~ ^[0-9a-f]{40}(,[0-9a-f]{40})*$ ]] || refuse "bad --shallow"
  # a branch is a name the runner compares and records: validated here, before it is used anywhere
  if [ -n "$branch" ]; then
    [[ "$branch" =~ ^[A-Za-z0-9._/-]{1,200}$ && "$branch" != *..* ]] || refuse "bad branch name"
  fi
  check_host || refuse "host $(hostname) is not the approved builder ($EXPECT_HOST)"
  [ -r "$PROFILE_DIR/$profile.sh" ] || refuse "no gate profile '$profile' in $PROFILE_DIR"
  command -v "$SYSTEMD_RUN_BIN" >/dev/null 2>&1 || refuse "no $SYSTEMD_RUN_BIN: the gate's service unit is required"
  mkdir -p "$BASE_DIR/repos" "$BASE_DIR/envs/$profile" "$BASE_DIR/wheels" "$BASE_DIR/queue" 2>/dev/null \
    || refuse "cannot create $BASE_DIR"
  if [ -n "$RUN_AS" ]; then chown "$RUN_AS" "$BASE_DIR/repos" 2>/dev/null || refuse "cannot hand the object store to $RUN_AS"; fi
  state_init || refuse "cannot create the root state directory $STATE_DIR"
  bind_points

  cmd_janitor >/dev/null 2>&1   # housekeeping: stale queue entries, markers, staged bundles, expired keep-refs
  local free; free="$(disk_free_gib)"
  [ -n "$free" ] || refuse "cannot read disk usage for $BASE_DIR"
  [ "$free" -lt "$MIN_FREE_GIB" ] && refuse "disk free ${free}GiB < ${MIN_FREE_GIB}GiB floor — refusing to start"

  # The limits are FIXED per profile, from the root-owned profile: never read from PR content.
  # shellcheck disable=SC1090
  local cores mem; { source "$PROFILE_DIR/$profile.sh"; } || refuse "profile $profile failed to load"
  cores="$(profile_cores)"; mem="$(profile_mem_mb)"
  [[ "$cores" =~ ^[0-9]+$ && "$mem" =~ ^[0-9]+$ ]] || refuse "profile $profile has no numeric limits"

  RUN_ID="$(date +%Y%m%dT%H%M%S)-$$"; UNIT="pneuma-gate-$RUN_ID"
  DEDUP_ID="$RUN_ID"          # also the gate's unit name: pneuma-gate-<id>
  # FIRST: the submitter's cap, and the record of this run. Nothing below (the store, the loopback route,
  # the bundle, the promote unit) happens for a submitter that is over its cap.
  log "gate for ${repo:-?} branch ${branch:-(detached)} head ${head:0:12} submitter $SUBMITTER"
  dedup_hold "$DEDUP_ID" "$repo" "$branch" "$head" "$SUBMITTER"
  case $? in
    0) ;;
    2) DEDUP_ID=""; refuse "submitter already holds $PER_SUBMITTER_CAP queued or running gates; wait for them";;
    *) DEDUP_ID=""; refuse "cannot record the gate";;
  esac
  local store; store="$(store_for "$repo")"
  if [ ! -d "$store" ]; then as_gate git init -q --bare "$store" || refuse "cannot init object store"; fi
  # A queued marker (pid + start time) exists before anything is staged, so the janitor never takes
  # a waiting runner's bundle; it holds no capacity until admit() makes it an admitted marker.
  state_mark "$RUN_ID" "$$" "$cores" "$mem" queued || refuse "cannot record the run"
  # The run's own loopback address: claimed with `ip route add`, which fails if any other run holds it.
  local loopback; loopback="$(loopback_claim "$RUN_ID")" || refuse "cannot claim a loopback address for the run"
  LOOPBACK="$loopback"
  state_mark "$RUN_ID" "$$" "$cores" "$mem" queued "$loopback" || refuse "cannot record the run"
  unit_props "$loopback" || refuse "cannot build the unit's properties (network allow list or write cap): see the message above"
  # The bundle is only staged, read-only, for the unit to unpack. The file is world-readable so
  # the unit's own uid can read it, but it sits in a 0700 root directory: the only way to it
  # is the bind mount of this one run.
  if [ "$bundle" = 1 ]; then
    BUNDLE_FILE="$STATE_DIR/in/$RUN_ID.bundle"
    head -c $((BUNDLE_MAX_MB * 1048576 + 1)) > "$BUNDLE_FILE"
    [ "$(stat -c %s "$BUNDLE_FILE")" -le $((BUNDLE_MAX_MB * 1048576)) ] || refuse "bundle over ${BUNDLE_MAX_MB}MB"
    chmod 0644 "$BUNDLE_FILE"
    if [ -n "$branch" ]; then
      bundle_binds "$BUNDLE_FILE" "$repo" "$branch" "$head" || refuse "bundle does not carry $repo branch $branch at $head"
    fi
    log "received bundle ($(du -h "$BUNDLE_FILE" | cut -f1))"
  else
    BUNDLE_FILE="$STATE_DIR/in/$RUN_ID.bundle"; : > "$BUNDLE_FILE"; chmod 0644 "$BUNDLE_FILE"   # an empty bundle: the unit uses the store alone
  fi
  # The bundle goes into the object store first (sandboxed promote unit), so the supersession decision
  # can tell ancestry from the store; the gate unit still unpacks the bundle itself for its own run.
  if [ "$bundle" = 1 ]; then promote_bundle "$store" "$BUNDLE_FILE" "$shallow" || true; fi
  dedup_decide "$DEDUP_ID" "$store" "$repo" "$branch" "$head" "$SUBMITTER"
  admit "$cores" "$mem"   # reserves capacity (counted while this runner is alive); systemd creates the run's directories

  local rc run_dir="$RUN_ROOT/$RUN_ID" work_dir="$UNIT_WORK/$RUN_ID"
  ABORT_FLAG="$STATE_DIR/abort-$RUN_ID"
  disk_guard "$UNIT" "$ABORT_FLAG" & GUARD_PID=$!
  log "launching unit $UNIT (cores=$cores mem=${mem}MB timeout=${GATE_TIMEOUT_S}s)"
  # The unit's stdout is the log; every line is prefixed so PR code cannot print a fake verdict
  # marker. Its exit status is the verdict. fd 9 (the admission lock) is not open here.
  "$SYSTEMD_RUN_BIN" --unit="$UNIT" --wait --collect --pipe --quiet "${SANDBOX_PROPS[@]}" "${UNIT_PROPS[@]}" \
    --property=MemoryMax="${mem}M" --property=CPUQuota="$((cores * 100))%" --property=TasksMax=512 \
    --property=RuntimeMaxSec="$GATE_TIMEOUT_S" \
    --property=RuntimeDirectory="pneuma-gate/$RUN_ID" --property=RuntimeDirectoryMode=0700 \
    --property=BindReadOnlyPaths="$BUNDLE_FILE:$IN_MOUNT/bundle" \
    --property=BindReadOnlyPaths="$store:$IN_MOUNT/store" \
    --property=BindReadOnlyPaths="$BASE_DIR/envs/$profile:$ENVS_MOUNT" \
    --property=BindReadOnlyPaths="$BASE_DIR/wheels:$WHEELS_MOUNT" -- \
    env -i PATH="$UNIT_PATH" LANG=C.UTF-8 PNEUMA_GATE_REMOTE_RUN=1 \
      PNEUMA_GATE_RUN_DIR="$run_dir" PNEUMA_GATE_WORK_DIR="$work_dir" \
      PNEUMA_GATE_PROFILE_DIR="$PROFILE_DIR" PNEUMA_GATE_IN_MOUNT="$IN_MOUNT" \
      PNEUMA_GATE_ENVS_MOUNT="$ENVS_MOUNT" PNEUMA_GATE_WHEELS_MOUNT="$WHEELS_MOUNT" \
      PNEUMA_GATE_CORES="$cores" PNEUMA_GATE_LOOPBACK="$loopback" "${fwd_env[@]}" \
    "$SELF" unit --profile "$profile" --head "$head" --base "$base" --tree "$tree" \
      --origin-main "$origin_main" --shallow "$shallow" --timeout "$GATE_TIMEOUT_S" \
      9>&- </dev/null 2>&1 | sed -u 's/^/  gate: /'
  rc="${PIPESTATUS[0]}"
  kill "$GUARD_PID" 2>/dev/null; GUARD_PID=""
  if [ -n "$(dedup_field "$DEDUP_ID" superseded)" ]; then
    log "gate superseded by $(dedup_field "$DEDUP_ID" superseded): verdict discarded"
    result 75 "superseded by $(dedup_field "$DEDUP_ID" superseded)"; return 75
  elif [ -e "$ABORT_FLAG" ]; then
    log "gate stopped: builder free space fell below ${ABORT_FREE_GIB}GiB"; result 75 "builder disk low"; return 75
  elif [ "$rc" -eq 0 ]; then
    log "gate GREEN"; result 0; return 0
  elif [ "$rc" -eq 75 ]; then
    log "gate did not reach a verdict (infrastructure)"; result 75 "no verdict from the gate unit"; return 75
  fi
  log "gate RED (exit $rc)"; result 1; return 1
}

# ── inside the gate's unit ───────────────────────────────────────────────────
# Everything below runs as the run's DynamicUser, in the sandbox, in the unit's cgroup. It trusts
# nothing but the profile (root-owned): the bundle, the checkout and every script in it are PR
# content, and they run only here.
unit_checkout() {   # <work> <head> <base> <tree> <origin_main> <shallow>: builds $work/ws
  local work="$1" head="$2" base="$3" tree="$4" om="$5" shallow="$6" store="$IN_MOUNT/store" o ws="$1/ws"
  mkdir -p "$ws" && git -C "$ws" init -q . || return 1
  echo "$store/objects" > "$ws/.git/objects/info/alternates"
  { cat "$store/shallow" 2>/dev/null; tr ',' '\n' <<<"$shallow" | grep -E '^[0-9a-f]{40}$'; } | sort -u > "$ws/.git/shallow"
  [ -s "$ws/.git/shallow" ] || rm -f "$ws/.git/shallow"
  if [ -s "$IN_MOUNT/bundle" ]; then
    git -C "$ws" fetch -q "$IN_MOUNT/bundle" "refs/pneuma-gate/*:refs/gate-keep/*" 2>&1 | sed 's/^/  fetch: /'
    [ "${PIPESTATUS[0]}" -eq 0 ] || { echo "bundle fetch failed"; return 75; }
  fi
  for o in "$head" "$base" ${om:+"$om"}; do
    git -C "$ws" cat-file -e "${o}^{commit}" 2>/dev/null || { echo "commit $o not in the store (ship a bundle)"; return 75; }
  done
  [ "$(git -C "$ws" rev-parse "${head}^{tree}")" = "$tree" ] || { echo "tree mismatch for $head"; return 75; }
  git -C "$ws" update-ref refs/gate/head "$head" && git -C "$ws" update-ref refs/gate/base "$base" || return 1
  # tests (e.g. the dead-SHA citation guard) resolve origin/main: give the workspace the same
  # one the dev box had, never a guess.
  if [ -n "$om" ]; then git -C "$ws" update-ref refs/remotes/origin/main "$om"; fi
  git -C "$ws" -c advice.detachedHead=false checkout -q --detach "$head" || return 1
  [ "$(git -C "$ws" rev-parse 'HEAD^{tree}')" = "$tree" ] || { echo "workspace tree mismatch"; return 75; }
  [ -z "$(git -C "$ws" status --porcelain)" ] || { echo "workspace not clean after checkout"; return 75; }
}

# The dependency env: a hit is the immutable cache (read-only mount); a miss is built here, in
# this unit's cgroup and private disk, and used by this run only (never published from a run).
unit_env() {   # <ws> <work> <profile> → sets ENV_DIR
  local ws="$1" work="$2" profile="$3" key
  key="$(cd "$ws" && profile_env_key)" || { echo "profile_env_key failed"; return 75; }
  safe_name "$key" || { echo "bad environment key"; return 75; }
  if [ -e "$ENVS_MOUNT/$key/.ready" ]; then
    ENV_DIR="$ENVS_MOUNT/$key"; echo "environment $profile/$key ready (read-only shared cache)"; return 0
  fi
  ENV_DIR="$work/env/$key"
  echo "environment $profile/$key not cached — building it in this unit (not published)"
  ( cd "$ws" && PNEUMA_GATE_WHEELS="$WHEELS_MOUNT" profile_env_build "$ENV_DIR" ) 2>&1 | sed -u 's/^/  env-build: /'
  local rc="${PIPESTATUS[0]}"
  [ "$rc" -eq 0 ] || { echo "environment build failed (rc=$rc)"; [ "$rc" -eq 75 ] && return 75; return 1; }
  touch "$ENV_DIR/.ready"
}

cmd_unit() {
  local profile="" head="" base="" tree="" om="" shallow="" timeout_s=5400
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) profile="$2"; shift 2;; --head) head="$2"; shift 2;; --base) base="$2"; shift 2;;
      --tree) tree="$2"; shift 2;; --origin-main) om="$2"; shift 2;; --shallow) shallow="$2"; shift 2;;
      --timeout) timeout_s="$2"; shift 2;; *) echo "unknown arg $1"; return 75;;
    esac
  done
  local run_dir="${PNEUMA_GATE_RUN_DIR:?}" work="${PNEUMA_GATE_WORK_DIR:?}"
  export HOME="$work/home" TMPDIR="$work/tmp"
  mkdir -p "$HOME" "$TMPDIR" "$run_dir" || return 75
  # shellcheck disable=SC1090
  source "$PROFILE_DIR/$profile.sh" || { echo "profile $profile failed to load"; return 75; }
  unit_checkout "$work" "$head" "$base" "$tree" "$om" "$shallow" || return $?
  # Optional profile hook: the scoping decision (diff size, selected services) at the top of the log,
  # so a wrong selection is visible in every verdict. It runs here, in the sandbox, with the PR's code.
  if declare -F profile_scope_report >/dev/null; then
    ( cd "$work/ws" && profile_scope_report "$base" "$head" ) 2>&1 | sed -u 's/^/  scope: /' || true
  fi
  ENV_DIR=""
  unit_env "$work/ws" "$work" "$profile" || return $?
  cd "$work/ws" || return 75
  profile_gate "$ENV_DIR" "$head" "$base" "$timeout_s"
}

# The bundle into the object store, inside the store owner's sandbox (no network). The shallow
# boundary of a shallow dev-box clone is recorded first, so the fetch accepts the cut.
cmd_promote() {
  local store="" bundle="" shallow=""
  while [ $# -gt 0 ]; do
    case "$1" in --store) store="$2"; shift 2;; --bundle) bundle="$2"; shift 2;; --shallow) shallow="$2"; shift 2;; *) return 2;; esac
  done
  [ -s "$bundle" ] || return 0
  exec 7>"$store/.promote.lock"; flock 7
  if [ -n "$shallow" ]; then
    { cat "$store/shallow" 2>/dev/null; tr ',' '\n' <<<"$shallow" | grep -E '^[0-9a-f]{40}$'; } | sort -u > "$store/shallow.new" &&
      mv "$store/shallow.new" "$store/shallow"
  fi
  git --git-dir="$store" -c transfer.fsckObjects=true fetch -q "$bundle" "refs/pneuma-gate/*:refs/gate-keep/*"
}

# ── warm-env: the only way an env reaches the shared cache ───────────────────
# A PR's own run never publishes (its tests could tamper with the env after the build). The
# operator builds the env for a TRUSTED ref (origin/main) in a sandboxed unit with the same
# limits, then root freezes it into the read-only cache. Proto wheels are staged here as root
# from a version string this runner validated (no PR code ever runs as root).
cmd_warm_env() {
  local profile="" repo="" ref=""
  while [ $# -gt 0 ]; do
    case "$1" in --profile) profile="$2"; shift 2;; --repo) repo="$2"; shift 2;; --ref) ref="$2"; shift 2;; *) return 2;; esac
  done
  { safe_name "$repo" && safe_name "$profile"; } || { echo "bad repo/profile" >&2; return 2; }
  [[ "$ref" =~ ^[0-9a-f]{40}$ ]] || { echo "--ref must be a 40-hex commit" >&2; return 2; }
  check_host || { echo "not the approved builder" >&2; return 75; }
  # shellcheck disable=SC1090
  source "$PROFILE_DIR/$profile.sh" || return 75
  local store; store="$(store_for "$repo")"
  as_gate git --git-dir="$store" cat-file -e "${ref}^{commit}" 2>/dev/null || { echo "$ref is not in the store" >&2; return 75; }
  state_init || return 75
  bind_points
  local id="warm-$(date +%Y%m%dT%H%M%S)-$$" cores mem
  cores="$(profile_cores)"; mem="$(profile_mem_mb)"
  local out key tag
  out="$(warm_unit "$id-key" "$store" "$profile" "$ref" "$cores" "$mem" key "" 2>&1)" || { printf '%s\n' "$out" >&2; return 75; }
  key="$(sed -n 's/^WARM_KEY=//p' <<<"$out" | tail -1)"; tag="$(sed -n 's/^WARM_TAG=//p' <<<"$out" | tail -1)"
  safe_name "$key" || { echo "bad key from the unit" >&2; return 75; }
  if [ -e "$BASE_DIR/envs/$profile/$key/.ready" ]; then echo "environment $profile/$key is already published"; return 0; fi
  if [ -n "$tag" ]; then
    [[ "$tag" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "refusing proto tag '$tag'" >&2; return 75; }
    if declare -F profile_stage_root >/dev/null; then profile_stage_root "$BASE_DIR" "$tag" || return 75; fi
  fi
  local slot="$BASE_DIR/envs/$profile/.slot-$id"
  # root-owned 0700 until the build unit starts; the unit's own start hands it to the dynamic uid
  # (ExecStartPre, see warm_unit), so no other local user can write into it before the freeze
  mkdir -p "$slot" && chmod 0700 "$slot" || return 75
  if ! warm_unit "$id-build" "$store" "$profile" "$ref" "$cores" "$mem" build "$slot:$ENVS_MOUNT/$key"; then
    rm -rf --one-file-system "$slot"; echo "environment build failed" >&2; return 75
  fi
  # Freeze: root-owned, read-only, .ready written last; renamed into place atomically.
  chown -R root:root "$slot" && touch "$slot/.ready" && chmod -R a-w,a+rX "$slot" && mv "$slot" "$BASE_DIR/envs/$profile/$key" \
    || { rm -rf --one-file-system "$slot"; return 75; }
  echo "published environment $profile/$key"
}

warm_unit() {   # <id> <store> <profile> <ref> <cores> <mem> <key|build> <slot bind or empty>
  local id="$1" store="$2" profile="$3" ref="$4" cores="$5" mem="$6" mode="$7" slot="$8" binds=() lo
  lo="$(loopback_claim "$id")" || return 75
  state_mark "$id" "$$" 0 0 warm "$lo" || { loopback_down "$lo"; return 75; }
  unit_props "$lo" || { loopback_down "$lo"; state_remove "$id"; return 75; }
  [ -n "$slot" ] && binds=(--property=BindPaths="$slot" --property=ExecStartPre="+$(command -v chown) --reference=$RUN_ROOT/$id ${slot#*:}")
  "$SYSTEMD_RUN_BIN" --unit="pneuma-warm-$id" --wait --collect --pipe --quiet "${SANDBOX_PROPS[@]}" "${UNIT_PROPS[@]}" \
    --property=MemoryMax="${mem}M" --property=CPUQuota="$((cores * 100))%" --property=TasksMax=512 \
    --property=RuntimeMaxSec="$GATE_TIMEOUT_S" \
    --property=RuntimeDirectory="pneuma-gate/$id" --property=RuntimeDirectoryMode=0700 \
    --property=BindReadOnlyPaths="$store:$IN_MOUNT/store" \
    --property=BindReadOnlyPaths="$BASE_DIR/wheels:$WHEELS_MOUNT" "${binds[@]}" -- \
    env -i PATH="$UNIT_PATH" LANG=C.UTF-8 PNEUMA_GATE_RUN_DIR="$RUN_ROOT/$id" PNEUMA_GATE_WORK_DIR="$UNIT_WORK/$id" \
      PNEUMA_GATE_PROFILE_DIR="$PROFILE_DIR" PNEUMA_GATE_IN_MOUNT="$IN_MOUNT" PNEUMA_GATE_ENVS_MOUNT="$ENVS_MOUNT" \
      PNEUMA_GATE_WHEELS_MOUNT="$WHEELS_MOUNT" PNEUMA_GATE_LOOPBACK="$lo" \
    "$SELF" warm-unit "$mode" --profile "$profile" --ref "$ref" </dev/null
  local rc=$?
  loopback_down "$lo"; state_remove "$id"
  return "$rc"
}

cmd_warm_unit() {   # inside a pneuma-warm unit
  local mode="$1"; shift
  local profile="" ref=""
  while [ $# -gt 0 ]; do
    case "$1" in --profile) profile="$2"; shift 2;; --ref) ref="$2"; shift 2;; *) return 75;; esac
  done
  local work="${PNEUMA_GATE_WORK_DIR:?}"
  export HOME="$work/home" TMPDIR="$work/tmp"; mkdir -p "$HOME" "$TMPDIR" || return 75
  # shellcheck disable=SC1090
  source "$PROFILE_DIR/$profile.sh" || return 75
  local tree; tree="$(git --git-dir="$IN_MOUNT/store" rev-parse "${ref}^{tree}")" || return 75
  unit_checkout "$work" "$ref" "$ref" "$tree" "" "" || return 75
  local key; key="$(cd "$work/ws" && profile_env_key)" || return 75
  safe_name "$key" || return 75
  if [ "$mode" = key ]; then
    echo "WARM_KEY=$key"
    if declare -F profile_wheels_tag >/dev/null; then echo "WARM_TAG=$(cd "$work/ws" && profile_wheels_tag)"; fi
    return 0
  fi
  ( cd "$work/ws" && PNEUMA_GATE_WHEELS="$WHEELS_MOUNT" profile_env_build "$ENVS_MOUNT/$key" )
}

main() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  # Elevated only through pneuma-gate-entry: sudo sets SUDO_USER (env_reset makes it unforgeable by a
  # non-root caller). Any other sudo user is refused. A root shell without sudo is an operator.
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != pneuma-submit ]; then
    echo "pneuma-gate-runner: refused: elevation by '$SUDO_USER' (only pneuma-submit may run the gate)" >&2; exit 75
  fi
  # ...and a submitter that got here through sudo may only run the verbs the sudoers rule names. The internal
  # verbs (unit, promote, warm-unit) and the operator verbs (janitor, guard, warm-env) are never a submitter's.
  if [ -n "${SUDO_USER:-}" ]; then
    case "$sub" in
      have|run|status) ;;
      *) echo "pneuma-gate-runner: refused: verb '$sub' is not available through the submit path" >&2; exit 75;;
    esac
  fi
  # `--submitter <id>` is placed by pneuma-gate-entry (sshd's forced command), never by a client.
  if [ "${1:-}" = --submitter ]; then SUBMITTER="${2:-}"; shift 2; fi
  case "$sub" in
    have) cmd_have "$@";;
    # every verb below requires an identity; there is no shared or empty submitter bucket
    run) [[ "$SUBMITTER" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || refuse_noid; cmd_run "$@"; exit $?;;
    status) cmd_status;;
    janitor) cmd_janitor;;
    guard) cmd_guard;;
    unit) cmd_unit "$@"; exit $?;;
    promote) cmd_promote "$@"; exit $?;;
    warm-env) cmd_warm_env "$@"; exit $?;;
    warm-unit) cmd_warm_unit "$@"; exit $?;;
    *) echo "usage: pneuma-gate-runner {have|run|status|janitor|warm-env}" >&2; exit 2;;
  esac
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
