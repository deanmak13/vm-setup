[Unit]
Description=Block public inbound to Docker-published ports (DOCKER-USER policy), applied before Docker starts
Documentation=https://github.com/deanmak13/vm-setup
# Before docker.service: restart-policy containers can never publish ports in an unfiltered window.
# The docker.service drop-in re-applies after every Docker (re)start, covering chain rewrites.
Before=docker.service
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/pneuma-docker-fw/docker-user-firewall.sh --apply --pre-docker

[Install]
WantedBy=multi-user.target docker.service
