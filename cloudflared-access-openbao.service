[Unit]
Description=cloudflared Access TCP proxy — ci-builder to TST OpenBao
# Replaces the old ssh -R 18200 reverse tunnel / kubectl port-forward, both
# of which required a human to keep a session alive and died silently.
# This proxies through Cloudflare Access instead: outbound-only from
# ci-builder (no inbound port needed on the TST side), authenticated with a
# Cloudflare Access Service Token, and restarted automatically by systemd.
# See ci-builder-openbao-access.md for the one-time setup this depends on.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# SECURITY: the service token travels ONLY via environment. cloudflared
# reads TUNNEL_SERVICE_TOKEN_ID / TUNNEL_SERVICE_TOKEN_SECRET natively, so
# no --service-token-* flags — systemd resolves ${VAR} in ExecStart into
# argv, which any local user could read via ps//proc/<pid>/cmdline on this
# shared 13-runner host.
EnvironmentFile=/etc/cloudflared/openbao-access.env
ExecStart=/usr/local/bin/cloudflared access tcp \
    --hostname ${CF_ACCESS_HOSTNAME} \
    --url 127.0.0.1:18200
Restart=always
RestartSec=5
# Least privilege: binds only 127.0.0.1:18200 (unprivileged) + outbound
# HTTPS — no root capability needed. DynamicUser gives a transient
# unprivileged account with no home/persistent state to manage.
DynamicUser=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
